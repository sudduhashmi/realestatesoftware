@model RealEstateRegalSpace.Models.Dashboard
@{
    ViewBag.Title = "DashBoard";
    Layout = "~/Views/Shared/Layout.cshtml";
}
<style>
    @@keyframes blink {
        50% {
            opacity: 0.0;
        }
    }

    @@-webkit-keyframes blink {
        50% {
            opacity: 0.0;
        }
    }

    .blink {
        animation: blink 1s step-start 0s infinite;
        -webkit-animation: blink 1s step-start 0s infinite;
        color: blue;
    }
</style>
<div class="wrapper">
    <div class="container-fluid">
        <div class="pcoded-inner-content">
            <div class="main-body">
                <div class="page-title-box">
                    <div class="row align-items-center">
                        <div class="col-sm-6">
                            <h4 class="page-title">Dashboard</h4>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-right">

                                <li class="breadcrumb-item active">Dashboard</li>
                            </ol>
                        </div>
                    </div>
                    <!-- end row -->
                </div>
                <div class="page-wrapper">
                    <div class="page-body">
                        @if (Model != null)
                        {
                            if (Model.associateDetails != null)
                            {
                                if (Model.associateDetails.Rows.Count > 0)
                                {
                                    <div class="row">
                                        <div class="col-md-12">
                                            <h4 style="color:blue">Welcome Back @Session["FullName"]</h4>
                                        </div>
                                    </div>
                                    <div class="row" style="@ViewBag.NoteStyle">
                                        <div class="col-md-12">
                                            <h4 style="color:red">
                                                Note : Please update your KYC Details otherwise your payout is not released.
                                                <br />
                                                नोट: कृपया अपना KYC अपडेट करें अन्यथा आपका भुगतान जारी नहीं किया जाएगा।
                                            </h4>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-xl-3 col-md-6 mb-4">
                                            <a href="/Associate/Direct">
                                                <div class="card border-left-primary shadow h-100 py-2" style="background-color:#02c58d">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1" style="color:#fff !important">
                                                                    Total Direct
                                                                </div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800" style="color:#fff">@Model.associateDetails.Rows[0]["TotalDirect"].ToString()</div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                        <div class="col-xl-3 col-md-6 mb-4">
                                            <a href="/Associate/Downline">
                                                <div class="card border-left-primary shadow h-100 py-2" style="background-color:#990099">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1" style="color:#fff !important">
                                                                    Total Downline
                                                                </div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800" style="color:#fff !important">@Model.associateDetails.Rows[0]["TotalDownline"].ToString()</div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                        <div class="col-xl-3 col-md-6 mb-4">
                                            <a href="/Associate/BusinessReport">
                                                <div class="card border-left-primary shadow h-100 py-2" style="background-color:#fcbe2d">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1" style="color:#fff !important">
                                                                    Total Business
                                                                </div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800" style="color:#fff !important">@Model.investmentDetails.Rows[0]["TOtalBusiness"].ToString()</div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>                                    
                                        <div class="col-xl-3 col-md-6 mb-4">
                                            <a href="#">
                                                <div class="card border-left-primary shadow h-100 py-2" style="background-color:#cc88ba">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1" style="color:#fff !important">
                                                                    Current Level
                                                                </div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800 blink" style="color:blue !important">@Model.investmentDetails.Rows[0]["DesignationName"].ToString()</div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="row gutters">
                                        <div class="col-xl-3 col-md-6 mb-4">
                                            <a href="/Associate/PayoutLedger">
                                                <div class="card border-left-primary shadow h-100 py-2" style="background-color:#8893cc">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1" style="color:#fff !important">
                                                                    Level Income
                                                                </div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800" style="color:#fff !important">@Model.investmentDetails.Rows[0]["LevelIncome"].ToString()</div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                        <div class="col-xl-3 col-md-6 mb-4">
                                            <a href="/Associate/PayoutLedger">
                                                <div class="card border-left-primary shadow h-100 py-2" style="background-color:#ab5aab">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1" style="color:#fff !important">
                                                                    TDS
                                                                </div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800" style="color:#fff !important">@Model.investmentDetails.Rows[0]["TDS"].ToString()</div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                        <div class="col-xl-3 col-md-6 mb-4">
                                            <a href="/Associate/PayoutLedger">
                                                <div class="card border-left-primary shadow h-100 py-2" style="background-color:#bd3030">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1" style="color:#fff !important">
                                                                    Admin Charge
                                                                </div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800" style="color:#fff !important">@Model.investmentDetails.Rows[0]["Processing"].ToString()</div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                        <div class="col-xl-3 col-md-6 mb-4">
                                            <a href="/Associate/PayoutLedger">
                                                <div class="card border-left-primary shadow h-100 py-2" style="background-color:#b59b5e">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1" style="color:#fff !important">
                                                                    Net Amount
                                                                </div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800" style="color:#fff !important">@Model.investmentDetails.Rows[0]["NetAmount"].ToString()</div>
                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="row gutters">
                                    </div>
                                    <div class="row gutters">                                    
                                    </div>
                                    <div class="row gutters">
                                        <div class="col-xl-3 col-md-6 mb-4">
                                            <a href="#">
                                                <div class="card border-left-primary shadow h-100 py-2" style="background-color:#b2c13c">
                                                    <div class="card-body">
                                                        <div class="row no-gutters align-items-center">
                                                            <div class="col mr-2">
                                                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1" style="color:#fff !important">
                                                                    Advance Payment
                                                                </div>
                                                                <div class="h5 mb-0 font-weight-bold text-gray-800" style="color:white !important">@Model.associateDetails.Rows[0]["Advance"].ToString()</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>