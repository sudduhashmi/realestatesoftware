
@{
    ViewBag.Title = "ConfirmRegistrationAssociate";
    Layout = "~/Views/Shared/Layout.cshtml";
}

<style>
    .bg-register {
        background: url(websitelinks/images/bg/login-bg.jpeg);
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        min-height: 100vh;
    }

    .user-account h1 {
        color: #2b2b2b;
        font-weight: 300;
        margin: 30px 0 20px;
    }

    .registration-block {
        background-color: rgba(256, 256, 256, 0.8);
        padding: 15px 40px;
    }

    h2.big-green {
        font-size: 35px;
        color: #77b43f;
        font-style: italic;
        /* text-transform: uppercase; */
        text-align: center;
        margin-bottom: 15px;
    }

    .wrapper-thanks h3, .wrapper-thanks h4, .wrapper-thanks h2 {
        margin-bottom: 15px;
    }

    .account-info.clearfix {
        margin-top: 20px;
        margin-bottom: 20px;
        padding: 10px 0;
    }

    .account-info .list-inline {
        margin: 0;
        padding: 0;
        text-align: center;
    }

        .account-info .list-inline li {
            display: inline-block;
        }

    span.border-box {
        border: 2px solid #77b43f;
        padding: 7px 5px;
        color: #4a9604;
        background: #f9f9f9;
    }

    .wrapper-thanks {
        width: 100%;
        padding-top: 30px;
        padding-bottom: 30px;
    }

    .animated-gif {
        width: 92px;
        height: 92px;
        border-radius: 50%;
        /* padding-right: 102px; */
        overflow: hidden;
        text-align: center;
        margin: 0 auto;
        line-height: 92px;
        border: 0px solid green;
    }
</style>
<style type="text/css">
    @@media (max-width:560px) {

        .account-info .list-inline li {
            display: inline-block;
            margin-top: 18px;
        }
    }
</style>

@section Header{

    <div class="row align-items-center">
        <div class="col-md-8">
            <div class="page-header-title">
                <h5 class="m-b-10">Associate</h5>

            </div>
        </div>
        <div class="col-md-4">
            <ul class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="javascript:void(0)"> <i class="fa fa-home"></i> </a>
                </li>


                <li class="breadcrumb-item">
                    <a href="#!">Congratulations</a>
                </li>
            </ul>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <h5>Associate Registration</h5>

    </div>
    <div class="card-block">

        <!-- Page-Title -->

        <div class="form-group row">
            <div class="col-lg-12">
                <div class="row">
                    <div class="wrapper-thanks">
                        <div class="animated-gif">
                            <img src="../../images/XwHw.gif" alt="" style="width: 100px;" />
                        </div>
                        <h2 class="big-green">Congratulations !!</h2>
                        <div class="clearfix text-center">
                            <h3>Now you are RealEstateRegalSpace  Associate</h3>

                            <div class="account-info clearfix">
                                <div class="clearfix text-left">
                                    <div class="col-md-12 account-info-text text-center">
                                        <ul class="list-inline">
                                            <li><span class="border-box">Name: @Session["DisplayNameConfirm"]</span></li>
                                            <li><span class="border-box">Login ID: @Session["LoginIDConfirm"]</span></li>
                                            <li><span class="border-box">Password:  @Session["PasswordConfirm"]</span></li>
                                        </ul>
                                    </div>
                                </div>


                            </div>

                            <div class="clearfix">
                                <h2 class="big-green">Thank You!</h2>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
