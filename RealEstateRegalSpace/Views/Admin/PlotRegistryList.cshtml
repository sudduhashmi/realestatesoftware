@model RealEstateRegalSpace.Models.Master

@{
    ViewBag.Title = "PlotRegistryList";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}


@using (Html.BeginForm("PlotRegistryList", "Admin", FormMethod.Post, new { @id = "form1" }))
{
    <div class="wrapper">
        <div class="container-fluid">
            <div class="card-block">
                <!-- Page-Title -->
                <div class="page-title-box">
                    <div class="row align-items-center">
                        <div class="col-sm-6">
                            <h4 class="page-title">Plot Registry List</h4>
                        </div>
                        
                    </div>
                    <!-- end row -->
                </div>
                <div class="form-group row">
                    <div class="col-lg-12">
                        <div class="row">
                            <p style="color:red">
                                @TempData["UpdateRegistry"]
                            </p>
                        </div>
                        @if (Model != null)
                        {

                            decimal totalarea = 0, totalplotrate = 0, totalplotamount = 0, totalplc = 0;
                            <table id="example23" class="table table-striped table-bordered nowrap table-responsive">
                                <thead>
                                    <tr>
                                        <th>S No.</th>
                                        <th>SiteName</th>
                                        <th>SectorName</th>
                                        <th>BlockName</th>
                                        <th>PlotNumber</th>
                                        <th>PlotArea</th>
                                        <th>PlotRate</th>
                                        <th>PlotAmount</th>
                                        <th>PLCCharge</th>
                                        <th>RegistreeNo</th>
                                        <th>RegistrationDate</th>
                                        <th>Khasra No</th>
                                        <th>Action</th>

                                    </tr>
                                </thead>
                                <tbody>

                                    @if (Model.lstPlot != null)
                                    {
                                        int i = 1;
                                        foreach (var Item in Model.lstPlot)
                                        {
                                            totalarea += decimal.Parse(Item.PlotArea);
                                            totalplotrate += decimal.Parse(Item.PlotRate);
                                            totalplotamount += decimal.Parse(Item.PlotAmount);
                                            totalplc += decimal.Parse(Item.PLCCharge);
                                            <tr class="text-left">
                                                <td>@i</td>
                                                <td>@Item.SiteName</td>
                                                <td>@Item.SectorName</td>
                                                <td>@Item.BlockName</td>
                                                <td>@Item.PlotNumber</td>
                                                <td>@Item.PlotArea</td>
                                                <td>@Item.PlotRate</td>
                                                <td>@Item.PlotAmount</td>
                                                <td>@Item.PLCCharge</td>
                                                <td>@Item.RegistreeNo</td>
                                                <td>@Item.RegistrationDate</td>
                                                <td>@Item.KhadraNo</td>

                                                <td>
                                                    <a href="#" class="btn btn-danger btn-sm" onclick="openPopup('@Item.PlotID','@Item.RegistreeNo','@Item.RegistrationDate','@Item.KhadraNo');" data-toggle="modal" data-target="#myModal">Edit</a>

                                                </td>




                                            </tr>

                                            i++;
                                        }
                                    }

                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th>Total</th>
                                        <th>@totalarea</th>
                                        <th>@totalplotrate</th>
                                        <th>@totalplotamount</th>
                                        <th>@totalplc</th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                        <th></th>

                                    </tr>
                                </tfoot>

                            </table>
                        }
                    </div>
                </div>
                <div class="modal fade" id="myModal" role="dialog" style="display: none">
                    <div class="modal-dialog">

                        <!-- Modal content-->
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" onclick="closeModal();">&times;</button>

                            </div>
                            <div class="modal-body" style="color: black">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label>Khasra No</label>
                                            <input type="text" id="KhadraNo" class="form-control" placeholder="Khasra No" />

                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Registree No</label>
                                            <input type="text" id="RegistreeNo" class="form-control" placeholder="Registree No" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Registree Date</label>
                                            <input type="text" id="RegistreeDate" class="form-control" placeholder="Registree Date" />
                                        </div>
                                    </div>
                                    <input type="hidden" id="plotid" />

                                    <div class="col-md-12">
                                        <div class="form-group">
                                            @*<a href="/Plot/CancelPlotBooking?BookingID=@Item.PK_BookingId" class="btn btn-danger btn-sm" onclick = "return confirm('Are you sure you want to cancel this booking?');">Cancel</a>*@
                                            <input type="button" class="btn btn-sm btn-danger pull-right" onclick="return updateregistry()" value="Update Registry" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @*<div class="modal-footer">
                                    <button type="button" class="btn btn-default" data-dismiss="modal" onclick="closeModal();">Close</button>
                                </div>*@
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>

}
<script src="../../Scripts/jquery-1.10.2.min.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">


<script>
    $(document).ready(function () {
        $("#divload").css({ 'display': 'none' });
    });

    $('#RegistreeDate').datepicker({
        dateFormat: 'dd/mm/yy',
        changeYear: true,
        changeMonth: true
    });
    function openPopup(plotid, RegistreeNo, RegistrationDate, KhadraNo) {
        $('#plotid').val(plotid);
        $('#KhadraNo').val(KhadraNo);
        $('#RegistreeNo').val(RegistreeNo);
        $('#RegistreeDate').val(RegistrationDate);
    }
    function updateregistry() {
        $(".errortext").removeClass("errortext");

        if ($('#KhadraNo').val() == '') {
            $("#KhadraNo").addClass('errortext');
            $('#KhadraNo').focus();
            return false;
        }
        if ($('#RegistreeNo').val() == '') {
            $("#RegistreeNo").addClass('errortext');
            $('#RegistreeNo').focus();
             return false;
         }

        if ($('#RegistreeDate').val() == '') {
            $("#RegistreeDate").addClass('errortext');
            $('#RegistreeDate').focus();
             return false;
         }

        var r = confirm('Are you sure you want to update this data ?');
        if (r == true) {
            //$("#divload").css({ 'display': '' });
            $.ajax({
                url: "/Admin/UpdateRegistry",
                Type: "Get",
                DataType: "JSON",
                data: { KhadraNo: $("#KhadraNo").val(), RegistreeNo: $("#RegistreeNo").val(), RegistreeDate: $('#RegistreeDate').val(), plotid: $('#plotid').val()},
                success: function (data) {
                    alert("Registry Updated Successfully");
                    window.location.href = '@Url.Action("PlotRegistryList", "Admin")';

                }

            });
        }
    }
</script>
