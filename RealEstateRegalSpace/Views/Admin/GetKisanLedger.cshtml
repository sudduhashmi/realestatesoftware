@model RealEstateRegalSpace.Models.Plot

@{
    ViewBag.Title = "GetKisanLedger";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@section Header{
    <div class="row align-items-center">
        <div class="col-md-8">
            <div class="page-header-title">
                <h5 class="m-b-10">Plot </h5>

            </div>
        </div>
        <div class="col-md-4">
            <ul class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="javascript:void(0)"> <i class="fa fa-home"></i> </a>
                </li>


                <li class="breadcrumb-item">
                    <a href="javascript:void(0);">Kisan Ledger</a>
                </li>

            </ul>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <h5>Reports</h5>
    </div>
    <div class="card-block">
        <!-- Page-Title -->

        <div class="form-group row">
            <div class="col-lg-12">

                <!--<div class="wrapper">
                    <div class="container-fluid">-->
                <!-- Page-Title -->
                <!--<div class="page-title-box">
                    <div class="row align-items-center">
                        <div class="col-sm-6">
                            <h4 class="page-title">Plot</h4>
                        </div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-right">

                                <li class="breadcrumb-item active">Kisan Ledger</li>
                            </ol>
                        </div>
                    </div>-->
                <!-- end row -->
                <!--</div>-->

                <table id="basicExample" class="table table-bordered">
                    <thead>
                        <tr>
                            <th>PaymentDate</th>
                            <th>PaidAmount</th>

                            <th>PaymentMode</th>

                            <th>TransactionNumber</th>
                            <th>TransactionDate</th>
                            <th>BankName</th>
                            <th>BankBranch</th>
                            <th>Action</th>


                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null)
                        {
                            if (Model.kisanList != null)
                            {
                                if (Model.kisanList.Rows.Count > 0)
                                {
                                    for (int i = 0; i <= Model.kisanList.Rows.Count - 1; i++)
                                    {
                                        <tr>
                                            <td>@Model.kisanList.Rows[i]["PaymentDate"].ToString()</td>

                                            <td>@Model.kisanList.Rows[i]["PaidAmount"].ToString()</td>

                                            <td>
                                                @Model.kisanList.Rows[i]["PaymentMode"].ToString()

                                            </td>
                                            <td>@Model.kisanList.Rows[i]["TransactionNumber"].ToString()</td>
                                            <td>@Model.kisanList.Rows[i]["TransactionDate"].ToString()</td>
                                            <td>@Model.kisanList.Rows[i]["BankName"].ToString()</td>
                                            <td>@Model.kisanList.Rows[i]["BankBranch"].ToString()</td>
                                            <td>
                                                <a class="btn btn-danger btn-sm" href="/Admin/DeleteKisanPayment?Id=@Model.kisanList.Rows[i]["PK_PaymentId"].ToString()" onclick="return confirm('Are you sure you wish to delete this entry?');">Delete Payment</a>
                                            </td>


                                        </tr>
                                    }

                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
