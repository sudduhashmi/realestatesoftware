@model RealEstateRegalSpace.Models.Login

@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <title>Regal Space Infratech Pvt. Ltd.</title>


    <!--[if lt IE 10]>
          <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
          <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
          <![endif]-->

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content="" />
    <meta name="keywords" content="" />
    <meta name="author" content="" />

    <link rel="icon" href="../files/assets/images/logo.png" type="image/x-icon">

    <link href="https://fonts.googleapis.com/css?family=Roboto:400,500" rel="stylesheet">

    <link rel="stylesheet" type="text/css" href="../files/bower_components/bootstrap/css/bootstrap.min.css">

    <link rel="stylesheet" href="../files/assets/pages/waves/css/waves.min.css" type="text/css" media="all">

    <link rel="stylesheet" type="text/css" href="../files/assets/icon/themify-icons/themify-icons.css">

    <link rel="stylesheet" type="text/css" href="../files/assets/icon/icofont/css/icofont.css">

    <link rel="stylesheet" type="text/css" href="../files/assets/icon/font-awesome/css/font-awesome.min.css">

    <link rel="stylesheet" type="text/css" href="../files/assets/css/style.css">
</head>
<body themebg-pattern="theme1">

    <section class="login-block">

        <div class="container">
            @using (Html.BeginForm("Login", "Home", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
            {
                <div class="row">
                    <div class="col-sm-12">

                        <form class="md-float-material form-material">
                            <div class="text-center" style=" margin: auto;  width:160px;">

                                <img class="img-fluid" alt="Logo" src="~/files/assets/images/logo.png" style="border-radius:3px;">
                            </div>
                            <div class="auth-box card">
                                <div class="card-block">
                                    <div class="row m-b-20">
                                        <div class="col-md-12">
                                            <h2 class="text-center">Sign In</h2>
                                        </div>
                                    </div>

                                    <div class="form-group form-primary">

                                        @Html.TextBoxFor(m => m.loginId, new { @class = "form-control form-bar", @placeholder = "Login Id" })
                                        <span class="form-bar"></span>

                                    </div>
                                    <div class="form-group form-primary">
                                        @Html.PasswordFor(m => m.password, new { @class = "form-control ", @placeholder = "Password" })
                                        <span class="form-bar"></span>
                                    </div>
                                    <div class="row m-t-25 text-left">
                                        <div class="col-12">
                                            <div class="checkbox-fade fade-in-primary d-">
                                                @*<a href="/Home/PlotAvailbility" class="additional-link">Plot <span>Availbility</span></a>*@
                                            </div>

                                            <div class="forgot-phone text-right f-right">
                                                <a href="#" class="additional-link" data-toggle="modal" data-target="#myModal">Forget Password</a>
                                                <br />

                                            </div>
                                        </div>
                                    </div>
                                    <div class="row m-t-30">
                                        <div class="col-md-12">
                                            <input type="submit" class="btn btn-primary btn-block" value="Login" onclick="return fvalidate();" />
                                            <p style="color:red">@TempData["Login"]</p>
                                        </div>
                                    </div>


                                    @*<div class="row">
                                        <div class="col-md-10">
                                            <p class="text-inverse text-left m-b-0">Thank you.</p>
                                            <p class="text-inverse text-left"><a href="#"><b>Back to website</b></a></p>
                                        </div>
                                        <div class="col-md-2">
                                            <img class="img-fluid" alt="Theme-Logo" src="~/files/assets/images/logo.png" style="border-radius:30px;height:30px;">
                                        </div>
                                    </div>*@

                                </div>
                            </div>
                        </form>

                    </div>

                </div>


                <div class="modal fade" id="myModal" role="dialog" style="display: none">
                    <div class="modal-dialog">

                        <!-- Modal content-->
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" onclick="closeModal();">&times;</button>

                            </div>
                            <div class="modal-body" style="color: black">
                                <div class="row">
                                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">

                                        <div class="form-group">

                                            <input type="text" class="form-control" placeholder="LoginId" id="login" />
                                        </div>

                                        <div class="mt-4">

                                            <a href="#" class="btn btn-success" onclick="return getpassword();">Get <span>Password</span></a>
                                        </div>

                                    </div>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            }

        </div>

    </section>


    <script type="text/javascript" src="../files/bower_components/jquery/js/jquery.min.js"></script>
    <script type="text/javascript" src="../files/bower_components/jquery-ui/js/jquery-ui.min.js"></script>
    <script type="text/javascript" src="../files/bower_components/popper.js/js/popper.min.js"></script>
    <script type="text/javascript" src="../files/bower_components/bootstrap/js/bootstrap.min.js"></script>

    <script src="../files/assets/pages/waves/js/waves.min.js"></script>

    <script type="text/javascript" src="../files/bower_components/jquery-slimscroll/js/jquery.slimscroll.js"></script>

    <script type="text/javascript" src="../files/bower_components/modernizr/js/modernizr.js"></script>
    <script type="text/javascript" src="../files/bower_components/modernizr/js/css-scrollbars.js"></script>

    <script type="text/javascript" src="../files/bower_components/i18next/js/i18next.min.js"></script>
    <script type="text/javascript" src="../files/bower_components/i18next-xhr-backend/js/i18nextXHRBackend.min.js"></script>
    <script type="text/javascript" src="../files/bower_components/i18next-browser-languagedetector/js/i18nextBrowserLanguageDetector.min.js"></script>
    <script type="text/javascript" src="../files/bower_components/jquery-i18next/js/jquery-i18next.min.js"></script>
    <script type="text/javascript" src="../files/assets/js/common-pages.js"></script>
</body>
</html>




<script src="../../assets/js/jquery.min.js"></script>
<script src="../../AdminPanelCss/js/bootstrap.min.js"></script>
<script>
    function fvalidate() {
        $(".errortext").removeClass("errortext");
        if ($('#loginId').val() == '') {
            $("#loginId").addClass('errortext');
            $('#loginId').focus();
            return false;
        }
        if ($('#password').val() == '') {
            $("#password").addClass('errortext');
            $('#password').focus();
            return false;
        }


    }
    function getpassword() {
        if ($('#login').val() == '') {
            $("#login").addClass('errortext');
            $('#login').focus();
            return false;
        }
        $.ajax({
            url: "/Home/GetPassword",
            Type: "Get",
            DataType: "JSON",
            data: { LoginId: $("#login").val() },
            success: function (data) {
                if (data.Result == "1") {
                    alert("Password Send on your registered mobile No.");
                }
                else {
                    alert("Invalid LoginId");
                }


            }

        });
    }
</script>