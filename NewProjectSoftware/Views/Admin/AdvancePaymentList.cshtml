@model RealEstateRegalSpace.Models.Wallet

@{
    ViewBag.Title = "AdvancePaymentList";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@using (Html.BeginForm("AdvancePaymentList", "Admin", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
{
    <div class="container-fluid">
        <!-- Page-Title -->
        <div class="page-title-box">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h4 class="page-title">Advance Payment Directory</h4>
                </div>
            </div>
        </div>

        <!-- Filter Card -->
        <div class="wizard-card animate-up">
            <div class="card-header-premium">
                <i class="fas fa-filter mr-2"></i> Search & Filter Records
            </div>
            <div class="p-4">
                <div class="row align-items-end">
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Member Login ID</label>
                        @Html.TextBoxFor(m => m.LoginId, new { @class = "form-control", @Placeholder = "Enter Login ID", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">From Date</label>
                        @Html.TextBoxFor(m => m.FromDate, new { @class = "form-control", @Placeholder = "dd/mm/yyyy", @readonly="readonly", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">To Date</label>
                        @Html.TextBoxFor(m => m.ToDate, new { @class = "form-control", @Placeholder = "dd/mm/yyyy", @readonly="readonly", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="d-block text-white">&nbsp;</label>
                        <button type="submit" class="btn btn-primary btn-block shadow-sm" style="height: 45px;">
                            <i class="fas fa-search mr-1"></i> Get Details
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Card -->
        <div class="wizard-card animate-up mt-4">
            <div class="card-header-premium secondary">
                <i class="fas fa-history mr-2"></i> Advance Payment History
            </div>
            <div class="p-0">
                <div class="table-responsive">
                    @if (Model != null)
                    {
                        decimal totalAmt = 0;
                        <table id="example23" class="table table-hover mb-0 custom-table text-nowrap">
                            <thead>
                                <tr>
                                    <th>Pmt Date</th>
                                    <th>Member Dtl</th>
                                    <th>Mode</th>
                                    <th>Reference / Bank</th>
                                    <th>Description</th>
                                    <th class="text-right">Amount</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.advancePayment != null && Model.advancePayment.Rows.Count > 0)
                                {
                                    for (int i = 0; i <= Model.advancePayment.Rows.Count - 1; i++)
                                    {
                                        totalAmt += decimal.Parse(@Model.advancePayment.Rows[i]["Amount"].ToString());
                                        <tr>
                                            <td><span class="small text-muted"><i class="fas fa-calendar-alt mr-1 text-primary"></i> @Model.advancePayment.Rows[i]["PaymentDate"].ToString()</span></td>
                                            <td>
                                                <div class="font-weight-bold text-dark">@Model.advancePayment.Rows[i]["FirstName"].ToString()</div>
                                                <span class="badge badge-soft-info">ID: @Model.advancePayment.Rows[i]["LoginID"].ToString()</span>
                                            </td>
                                            <td>
                                                <span class="badge badge-soft-success px-2">@Model.advancePayment.Rows[i]["PaymentMode"].ToString()</span>
                                            </td>
                                            <td><span class="small text-dark font-weight-bold">@Model.advancePayment.Rows[i]["PayMode"].ToString()</span></td>
                                            <td style="max-width: 200px; white-space: normal;"><span class="small">@Model.advancePayment.Rows[i]["Description"].ToString()</span></td>
                                            <td class="text-right font-weight-bold text-success">@Model.advancePayment.Rows[i]["Amount"].ToString()</td>
                                            <td class="text-center">
                                                <div class="btn-group">
                                                    <a class="btn btn-outline-primary btn-sm rounded-circle mr-2" style="width: 32px; height: 32px; padding: 5px;" 
                                                       href="/Admin/AdvancePayment?PK_AdvancePaymentID=@RealEstateRegalSpace.Crypto.Encrypt(Model.advancePayment.Rows[i]["PK_AdvancePaymentID"].ToString())" title="Edit">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a class="btn btn-outline-danger btn-sm rounded-circle" style="width: 32px; height: 32px; padding: 5px;"
                                                       href="/Admin/DeleteAdvancePayment?PK_AdvancePaymentID=@RealEstateRegalSpace.Crypto.Encrypt(Model.advancePayment.Rows[i]["PK_AdvancePaymentID"].ToString())" 
                                                       onclick="return confirm('Are you sure you want to delete this record?');" title="Delete">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            <tfoot class="bg-light">
                                <tr>
                                    <th colspan="5" class="text-right font-weight-bold h6">Grand Total:</th>
                                    <th class="text-right font-weight-bold h5 text-primary">₹ @totalAmt.ToString("N2")</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}
<script src="../../assets/js/jquery.min.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">

<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.17.1/moment-with-locales.min.js"></script>
<script>
    $('#FromDate').datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true
    });
    $('#Todate').datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true
    });

    $(document).ready(function () {
        $("#divload").css({ 'display': 'none' });


    });

</script>



