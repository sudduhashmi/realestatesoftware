@model RealEstateRegalSpace.Models.Reports
@{
    ViewBag.Title = "BalanceSheet";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<div class="container-fluid">
    <!-- Page-Title -->
    <div class="page-title-box">
        <div class="row align-items-center">
            <div class="col-sm-6">
                <h4 class="page-title">Financial Balance Sheet</h4>
            </div>
        </div>
    </div>

    <div class="wizard-card animate-up">
        <div class="card-header-premium">
            <i class="fas fa-file-invoice-dollar mr-2"></i> Company Assets & Liabilities Summary
        </div>
        <div class="p-4">
            <div class="table-responsive">
                <table id="balanceSheetTable" class="table table-hover custom-table">
                    <thead class="bg-light">
                        <tr>
                            <th class="text-center">Sr No</th>
                            <th>Particular</th>
                            <th>Transaction No</th>
                            <th>Transaction Date</th>
                            <th class="text-right">Debit (Dr)</th>
                            <th class="text-right">Credit (Cr)</th>
                            <th class="text-right font-weight-bold">Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.lstDetails != null && Model.lstDetails.Rows.Count > 0)
                        {
                            int k = 1;
                            for (int i = 0; i <= Model.lstDetails.Rows.Count - 1; i++)
                            {
                                var headId = Model.lstDetails.Rows[i]["Pk_HeadId"].ToString();
                                var isType6 = headId == "6";
                                <tr class="@(isType6 ? "table-primary-soft" : "table-info-soft") font-weight-bold">
                                    <td class="text-center">@k</td>
                                    <td>
                                        <a data-toggle="collapse" href="#collapseExample_@headId" role="button" aria-expanded="false" class="text-primary d-flex align-items-center">
                                            <i class="fas fa-chevron-circle-down mr-2 collapse-icon"></i>
                                            @Model.lstDetails.Rows[i]["AccountHead"].ToString()
                                        </a>
                                    </td>
                                    <td class="text-muted small">- Summary -</td>
                                    <td class="text-muted small">-</td>
                                    <td class="text-right text-danger">@Model.lstDetails.Rows[i]["Debit"].ToString()</td>
                                    <td class="text-right text-success">@Model.lstDetails.Rows[i]["Credit"].ToString()</td>
                                    <td class="text-right text-dark font-weight-bold">@Model.lstDetails.Rows[i]["Balance"].ToString()</td>
                                </tr>

                                int l = 1;
                                for (int j = 0; j <= Model.dtDetails.Rows.Count - 1; j++)
                                {
                                    if (headId == Model.dtDetails.Rows[j]["FK_HeadID"].ToString())
                                    {
                                        <tr class="collapse bg-white border-left-highlight" id="collapseExample_@headId">
                                            <td class="text-center text-muted small">@k.@l</td>
                                            <td class="pl-5 text-secondary">
                                                <i class="fas fa-caret-right mr-2 text-muted"></i>
                                                @Model.dtDetails.Rows[j]["Narration"].ToString()
                                            </td>
                                            <td><span class="badge badge-soft-secondary">@Model.dtDetails.Rows[j]["TransactionNo"].ToString()</span></td>
                                            <td>@Model.dtDetails.Rows[j]["TransactionDate"].ToString()</td>
                                            <td class="text-right text-muted">@Model.dtDetails.Rows[j]["DrAmount"].ToString()</td>
                                            <td class="text-right text-muted">@Model.dtDetails.Rows[j]["CrAmount"].ToString()</td>
                                            <td class="text-right font-weight-500">@Model.dtDetails.Rows[j]["Balance"].ToString()</td>
                                        </tr>
                                        l++;
                                    }
                                }
                                k++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-folder-open fa-3x mb-3 d-block"></i>
                                        No financial records found for the current period.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .table-primary-soft { background-color: rgba(0, 65, 145, 0.05); }
    .table-info-soft { background-color: rgba(23, 162, 184, 0.05); }
    .border-left-highlight { border-left: 4px solid #004191 !important; }
    .collapse-icon { transition: transform 0.3s ease; }
    [aria-expanded="true"] .collapse-icon { transform: rotate(180deg); }
    .font-weight-500 { font-weight: 500; }
    .badge-soft-secondary { background-color: #f1f5f9; color: #475569; }
</style>

