@model RealEstateRegalSpace.Models.Reports
@{
    ViewBag.Title = "BinaryTree";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}


@using (Html.BeginForm("BinaryTree", "Admin", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
{
   
    <div class="wrapper">
        <div class="container-fluid">
            <!-- Page-Title -->
            <div class="page-title-box">
                <div class="row align-items-center">
                    <div class="col-sm-6">
                        <h4 class="page-title">Team</h4>
                    </div>
                    <div class="col-sm-6">
                        <ol class="breadcrumb float-right">

                            <li class="breadcrumb-item active">Tree</li>
                        </ol>
                    </div>
                </div>
                <!-- end row -->
            </div>
            <div class="row">
                <div class="col-sm-3">
                    Associate Id
                    @Html.TextBoxFor(m => m.LoginId, new { @class = "form-control", @Placeholder = "Associate Id" })
                </div>
                <div class="col-sm-3">
                    <br />
                    <input type="submit" value="Get Details" class="btn btn-primary" />
                </div>
            </div>
            <div class="form-group row">

                <div class="col-lg-12">
                    <div class="row">
                        <iframe id="frm" src="~/LevelTree.aspx" style="height:500px;border: 0px solid;width:100%"></iframe>
                    </div>
                    <!-- Row ends -->

                </div>
                <!-- END: .main-content -->
                <!-- BEGIN .main-footer -->

            </div>
        </div>
    </div>

}

