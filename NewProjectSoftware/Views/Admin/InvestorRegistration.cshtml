@model RealEstateRegalSpace.Models.InvestorModelNew
@{
    ViewBag.Title = "InvestorRegistration";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}


@using (Html.BeginForm("InvestorRegistration", "Admin", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
{
    <div class="wrapper">
        <div class="container-fluid">
            
            <div class="card-block">

                <!-- Page-Title -->
                <div class="page-title-box">
                    <div class="row align-items-center">
                        <div class="col-sm-6">
                            <h4 class="page-title">Investor Registration</h4>
                        </div>
                      
                    </div>
                    <!-- end row -->
                </div>
                <div class="form-group row">
                    <div class="col-lg-12">

                        <div class="card">
                            <div class="card-body">
                                <div class="row mb-4">
                                    <div class="col-sm-3">
                                        First Name
                                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", @Placeholder = "First Name" })
                                    </div>
                                    <div class="col-sm-3">
                                        Last Name
                                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", @Placeholder = "Last Name" })
                                    </div>
                                    <div class="col-sm-3">
                                        Investor Type <span style="color:red">*</span>
                                        @Html.DropDownListFor(m => m.InvestorType, new SelectList(ViewBag.InvestorTypes, "Value", "Text"), new { @class = "select2-container form-control show-tick ms select2", onchange = "ChangeInterestType()" })
                                    </div>
                                    <div class="col-sm-3" id="divinteresttype" style="display:none">
                                        Interest Type <span style="color:red">*</span>
                                        @Html.DropDownListFor(m => m.InterestType, new SelectList(ViewBag.InterestTypes, "Value", "Text"), new { @class = "select2-container form-control show-tick ms select2" })
                                    </div>
                                    <div class="col-sm-3">
                                        Company Name
                                        @Html.TextBoxFor(m => m.CompanyName, new { @class = "form-control", @Placeholder = "Company Name" })
                                    </div>
                                </div>
                                <div class="row mb-4">

                                    <div class="col-sm-3">
                                        Mobile No <span style="color:red">*</span>
                                        @Html.TextBoxFor(m => m.MobileNo, new { @class = "form-control", @Placeholder = "Mobile No." })
                                    </div>
                                    <div class="col-sm-3">
                                        Email Address<span style="color:red">*</span>
                                        @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", @Placeholder = "Email Address" })
                                    </div>
                                    <div class="col-sm-3">
                                        Investor Percentage(%)<span style="color:red">*</span>
                                        @Html.TextBoxFor(m => m.InvestorPerc, new { @class = "form-control", @Placeholder = "Investor Percentage(%)" })
                                    </div>
                                    <div class="col-sm-3">
                                        Address<span style="color:red">*</span>
                                        @Html.TextAreaFor(m => m.Address, new { @class = "form-control", @Placeholder = "Address" })
                                    </div>
                                </div>
                               
                                <div class="row">
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <input class="btn btn-success " type="submit" onclick="return validateform();" value="Save" id="btnSave" name="btnSave" />
                                        </div>
                                    </div>
                                    <div class="col-md-10">
                                        <a style="color:red">
                                            @TempData["InvestorRegistration"]
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script src="../../Scripts/jquery-1.10.2.min.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">

<script type="text/javascript">
     $(document).ready(function () {


        var msg ='@TempData["InvestorRegistration"]';
         if (msg == 'Data Save Successfully') {
            var kisancode ='Investor Registered Successfully, Investor Code : ' +'@TempData["InvestorCode"]';
            alert(kisancode);
        }
          //alert('a');
    });
    function validateform() {
        $(".errortext").removeClass("errortext");
        if ($('#FirstName').val() == '') {
            $("#FirstName").addClass('errortext');
            $('#FirstName').focus();
            $('#FirstName').val('');
            //   alert("Please Fill Sponsor ID .")
            return false;
        }
        if ($('#InvestorType').val() == '0') {
            $("#InvestorType").addClass('errortext');
            $('#InvestorType').focus();
            $('#InvestorType').val('0');
            return false;
        }
        if ($('#MobileNo').val() == '') {
            $("#MobileNo").addClass('errortext');
            $('#MobileNo').focus();
            //  alert("Please Fill First Name .")
            return false;
        }
        if ($('#EmailAddress').val() == '') {
            $("#EmailAddress").addClass('errortext');
            $('#EmailAddress').focus();
            //  alert("Please Fill Mobile Number .")
            return false;
        }
        if ($('#InvestorPerc').val() == '') {
            $("#InvestorPerc").addClass('errortext');
            $('#InvestorPerc').focus();
            //    alert("Please Fill PAN .")
            return false;
        }

        $("#divload").css({ 'display': '' });
        return true;
    }
    function ChangeInterestType() {
        debugger;
        $('#InterestType').val('0');
        var InvestorType = $("#InvestorType").val();
        //alert(InvestorType);
        if (InvestorType == '1') {
            $("#divinteresttype").css({ 'display': 'block' });

        }
        else {
            $("#divinteresttype").css({ 'display': 'none' });
        }
    };
</script>

