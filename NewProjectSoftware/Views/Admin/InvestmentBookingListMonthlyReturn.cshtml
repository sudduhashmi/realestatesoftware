@model RealEstateRegalSpace.Models.Plot

@{
    ViewBag.Title = "Monthly Return Booking List";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@section Header{

    <div class="row align-items-center">
        <div class="col-md-8">
            <div class="page-header-title">
                <h5 class="m-b-10">Monthly Return Booking List</h5>

            </div>
        </div>
        <div class="col-md-4">
            <ul class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="javascript:void(0)"> <i class="fa fa-home"></i> </a>
                </li>


                <li class="breadcrumb-item">
                    <a href="#!">Monthly Return Booking List</a>
                </li>
            </ul>
        </div>
    </div>
}

@using (Html.BeginForm("InvestmentBookingListMonthlyReturn", "Admin", FormMethod.Post, new { @id = "form1" }))
{
    <div class="card">
        <div class="card-header">
            <h5>Plot</h5>

        </div>
        <div class="card-block">

            <!-- Page-Title -->

            <div class="form-group row">
                <div class="col-lg-12">
                    <div class="row">
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    Customer ID
                                    @Html.TextBoxFor(m => m.CustomerID, new { @class = "form-control", @Placeholder = "Search by Customer ID" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    Associate ID
                                    @Html.TextBoxFor(m => m.AssociateID, new { @class = "form-control", @Placeholder = "Search by Associate ID" })
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="form-group">
                                    From Date
                                    @Html.TextBoxFor(m => m.FromDate, new { @class = "form-control", @Placeholder = "From Date", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    To Date
                                    @Html.TextBoxFor(m => m.ToDate, new { @class = "form-control", @Placeholder = "To Date", @readonly = "readonly" })
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    Booking No
                                    @Html.TextBoxFor(m => m.BookingNumber, new { @class = "form-control", @Placeholder = "Booking No" })
                                </div>
                            </div>

                            <div class="col-md-2">
                                <div class="form-group">
                                    <br />
                                    <input class="btn btn-success" type="submit" value="Search" id="btnSearch" name="Search" />
                                </div>
                            </div>
                        </div>
                        <div class="dt-responsive table-responsive">
                            <table id="example23" class="table table-striped table-bordered nowrap">
                                <thead>
                                    <tr>
                                        <th>S No.</th>
                                        <th>Booking No</th>
                                        <th>Site</th>
                                        <th>Plot No.</th>

                                        <th>Customer Name</th>
                                        <th>AssociateName</th>
                                        <th>Investment Amount</th>
                                        <th>Plan</th>
                                        <th>Return %</th>
                                        <th>Tenure (Months)</th>
                                        <th>Return Amount</th>
                                        <th>Booking Date</th>
                                        @*<th>
                                                Action
                                            </th>*@

                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null)
                                    {
                                        if (Model.lstPlot != null)
                                        {
                                            int i = 1;
                                            foreach (var Item in Model.lstPlot)
                                            {
                                                <tr class="text-left">
                                                    <td>@i</td>
                                                    <td>@Item.BookingNumber</td>
                                                    <td>@Item.SiteName</td>
                                                    <td>@Item.PlotNumber</td>

                                                    <td>@Item.CustomerName (@Item.CustomerLoginID)</td>
                                                    <td>@Item.AssociateName (@Item.AssociateLoginID)</td>
                                                    <td>@Item.InvestmentAmount</td>
                                                    <td>@Item.PlanName</td>
                                                    <td>@Item.ReturnPercent</td>
                                                    <td>@Item.Tenure</td>
                                                    <td>@Item.ReturnAmount</td>
                                                    <td>@Item.BookingDate</td>
                                                    @*<td>
                                                            <a class="btn btn-success btn-sm" href="/Admin/PlotBooking?PK_BookingId=@Item.PK_BookingId">Edit</a>
                                                            @if (Item.PaymentPlan != "Full Payment Plan" && Item.IsEMICalculated == "0")
                                                            {
                                                                <a class="btn btn-primary btn-sm" style="cursor:pointer;color:white" onclick="return createEMI('@Item.PK_BookingId');">Create EMI</a>
                                                            }

                                                        </td>*@

                                                </tr>
                                                i++;
                                            }
                                        }
                                    }

                                </tbody>

                            </table>
                        </div>
                    </div>
                </div>
                <div class="modal fade" id="myModal" role="dialog" style="display: none">
                    <div class="modal-dialog">

                        <!-- Modal content-->
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" onclick="closeModal();">&times;</button>

                            </div>
                            <div class="modal-body" style="color: black">
                                <div class="row">
                                    <input type="hidden" id="PK_BookingId" />
                                    <div class="col-md-6">
                                        No Of EMI
                                        <input type="text" id="noofEMI" class="form-control" placeholder="No Of EMI" />
                                    </div>
                                    <div class="col-md-6">
                                        <input type="button" value="Create EMI" class="btn btn-primary" onclick="return EMICreate();" />
                                    </div>
                                </div>
                            </div>
                            @*<div class="modal-footer">
                                    <button type="button" class="btn btn-default" data-dismiss="modal" onclick="closeModal();">Close</button>
                                </div>*@
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">

<script>
    function createEMI(PK_BookingId) {
        $("#myModal").modal('show');

        $('#PK_BookingId').val(PK_BookingId);

    }
    function EMICreate() {
        $.ajax({
            url: '/Admin/CreateEMI', type: 'post', dataType: 'json',
            data: { 'PK_BookingId': $('#PK_BookingId').val(), noofEMI: $('#noofEMI').val() },
            success: function (data) {
                $("#divload").css({ 'display': 'none' });

            }

        });

    }
    $('#FromDate').datepicker({
        dateFormat: 'dd/mm/yy',
        changeYear: true,
        changeMonth: true
    });
    $('#Todate').datepicker({
        dateFormat: 'dd/mm/yy',
        changeYear: true,
        changeMonth: true
    });
    function onSiteChange() {
        $("#divload").css({ 'display': '' });
        var value = $('#SiteID').val();
        var values = $('#SectorID').val();
        var tr = [];
        $.ajax({
            url: "/Masters/GetSiteDetails",
            Type: "Get",
            DataType: "JSON",
            data: { SiteID: value },
            success: function (data) {
                $("#divload").css({ 'display': 'none' });
                var j = 1;
                if (data.Result == "yes") {

                    $("#SectorID").html(""); // clear before appending new list
                    $("#SectorID").empty();
                    $("#SectorID").append(
                        $('<option></option>').val(0).html('Select Sector'));
                    $.each(data.ddlSector, function (index, Sectorcount) {
                        $("#SectorID").append(
                            $('<option></option>').val(Sectorcount.Value).html(Sectorcount.Text));

                    });
                }
                else {
                    $("#SectorID").empty();

                }
            }

        });

    }

    function onSectorChange() {

        $("#divload").css({ 'display': '' });
        var siteID = $('#SiteID').val();
        var sectorID = $('#SectorID').val();
        $.ajax({
            url: '/Masters/GetBlockList', type: 'post', dataType: 'json',
            data: { 'SiteID': siteID, 'sectorID': sectorID },
            success: function (data) {
                $("#divload").css({ 'display': 'none' });
                $("#BlockID").html(""); // clear before appending new list
                $("#BlockID").empty();
                $("#BlockID").append(
                    $('<option></option>').val(0).html('Select Block'));
                $.each(data.lstBlock, function (index, BlockCount) {
                    $("#BlockID").append(
                        $('<option></option>').val(BlockCount.Value).html(BlockCount.Text));
                });

            }

        });
    }
</script>
