@model RealEstateRegalSpace.Models.Reports
@{
    ViewBag.Title = "TreeNew";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@using (Html.BeginForm("TreeNew", "Admin", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
{
    <div class="wrapper">
    <div class="container-fluid">
        <!-- Page-Title -->
        <div class="page-title-box">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h4 class="page-title">Downline Tree View</h4>
                </div>
            </div>
        </div>

        <!-- Filter Card -->
        <div class="wizard-card animate-up">
            <div class="card-header-premium">
                <i class="fas fa-search mr-2"></i> Search Associate
            </div>
            <div class="p-4">
                <div class="row align-items-end">
                    <div class="col-md-4">
                        <div class="form-group mb-0">
                            <label class="font-weight-bold text-dark">Associate Id <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.LoginId, new { @class = "form-control", @Placeholder = "Enter Associate Id", @style="height: 45px;" })
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group mb-0">
                            <label class="d-block">&nbsp;</label>
                            <button type="submit" class="btn btn-primary btn-block shadow-sm" style="height: 45px; white-space: nowrap; line-height: 1;">
                                Get Details
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tree Card -->
        <div class="wizard-card animate-up mt-4">
            <div class="card-header-premium secondary">
                <i class="fas fa-sitemap mr-2"></i> Hierarchy Visualization
            </div>
            <div class="p-0 overflow-hidden" style="border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;">
                <iframe id="frm" src="~/DownlineTreeNew.aspx" style="height:800px; border:none; width:100%; display:block; background: #f8f9fa;"></iframe>
            </div>
        </div>
    </div>
    </div>
}
