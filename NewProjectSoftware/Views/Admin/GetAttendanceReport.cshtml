@model RealEstateRegalSpace.Models.HRManagement

@{
    ViewBag.Title = "GetAttendanceReport";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@using (Html.BeginForm("GetAttendanceReport", "Admin", FormMethod.Post, new { @id = "signupForm", enctype = "multipart/form-data" }))
{
    <div class="wrapper">
        <div class="container-fluid">

            <div class="card-block">
                <!-- Page-Title -->
                <div class="page-title-box">
                    <div class="row align-items-center">
                        <div class="col-sm-6">
                            <h4 class="page-title">Attendance Report</h4>
                        </div>
                        
                    </div>
                    <!-- end row -->
                </div>
                <div class="form-group row">
                    <div class="col-lg-12">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="card m-b-30">
                                    <div class="card-body">
                                        <p style="color:red">
                                            @TempData["EmployeeSalarySlip"]
                                        </p>

                                        <div class="card-body">

                                            <div class="row justify-content-center">
                                                <div class="col-md-12 mx-auto">
                                                    <div class="row ">
                                                        <div class="col-lg-3 col-md-3">

                                                            <div class="form-group">
                                                                <label>Username </label>
                                                                @Html.TextBoxFor(m => m.LoginId, new { @class = "form-control", @Placeholder = "Username" })
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-3">

                                                            <div class="form-group">
                                                                <label>From Date </label>
                                                                @Html.TextBoxFor(m => m.FromDate, new { @class = "form-control", @Placeholder = "From Date" })
                                                            </div>
                                                        </div>
                                                        <div class="col-lg-3 col-md-3">

                                                            <div class="form-group">
                                                                <label>ToDate </label>
                                                                @Html.TextBoxFor(m => m.ToDate, new { @class = "form-control", @Placeholder = "To Date" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-lg-3 col-md-3">
                                                            <div class="form-group">
                                                                <input type="submit" value="Get Details" class="btn btn-primary" name="Search" onclick="return ValidateSearch();" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @if (Model != null)
                                                    {
                                                        if (Model.dtQualification != null)
                                                        {
                                                            <div class="row">
                                                                <div class="table-responsive">

                                                                    <div class="col-md-12">

                                                                        <table id="example23" class="display nowrap table table-hover table-striped table-bordered" cellspacing="0">
                                                                            <thead>
                                                                                <tr>

                                                                                    <th>Sr.No.</th>
                                                                                    <th>Emp Code</th>
                                                                                    <th>Emp Name</th>
                                                                                    <th>Attendance Date</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                @if (Model != null)
                                                                                {
                                                                                    if (Model.dtQualification != null)
                                                                                    {
                                                                                        int i = 1;
                                                                                        for (int j = 0; j <= Model.dtQualification.Rows.Count - 1; j++)
                                                                                        {
                                                                                            <tr>

                                                                                                <td>
                                                                                                    @i
                                                                                                </td>
                                                                                                <td>@Model.dtQualification.Rows[j]["LoginId"].ToString()</td>
                                                                                                <td>@Model.dtQualification.Rows[j]["Name"].ToString()</td>

                                                                                                <td>@Model.dtQualification.Rows[j]["AttendanceDate"].ToString()</td>

                                                                                            </tr>
                                                                                            i++;
                                                                                        }
                                                                                        <input type="hidden" id="hdRows" name="hdRows" value="@i" />
                                                                                    }
                                                                                }

                                                                            </tbody>

                                                                        </table>



                                                                    </div>
                                                                </div>

                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>

                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script src="../../assets/js/jquery.min.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.17.1/moment-with-locales.min.js"></script>

<script>

    $(document).ready(function () {
        $("#divload").css({ 'display': 'none' });
    });

    $('#FromDate').datepicker({
        dateFormat: 'dd/mm/yy',
        changeMonth: true,
        changeYear: true,
    });

    $('#ToDate').datepicker({
        dateFormat: 'dd/mm/yy',
        changeMonth: true,
        changeYear: true,
    });

    function ValidateSearch() {

        $(".errortext").removeClass("errortext");
        //if ($("#FromDate").val() == "") {
        //    $("#FromDate").addClass('errortext');
        //    $("#FromDate").focus();
        //    return false;
        //}
        //if ($("#ToDate").val() == "") {
        //    $("#ToDate").addClass('errortext');
        //    $("#ToDate").focus();
        //    return false;
        //}
        $("#divload").css({ 'display': '' });
        return true;

    }
</script>


