@model RealEstateRegalSpace.Models.DayBook

@{
    ViewBag.Title = "ExpenseEntry";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}


@using (Html.BeginForm("ExpenseEntry", "Admin", FormMethod.Post, new { @id = "form1" }))
{
    <div class="container-fluid">
        <!-- Page-Title -->
        <div class="page-title-box">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h4 class="page-title">New Expense Entry</h4>
                </div>
            </div>
        </div>

        <div class="wizard-card animate-up">
            <div class="card-header-premium">
                <i class="fas fa-receipt mr-2"></i> Expense Transaction Details
            </div>
            <div class="p-4">
                @if (TempData["DayBook"] != null)
                {
                    <div class="alert alert-soft-info border-0 mb-4">
                        <i class="fas fa-info-circle mr-2"></i> @TempData["DayBook"]
                    </div>
                }

                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="d-flex justify-content-between mb-1">
                            <label class="font-weight-bold text-dark mb-0">Login ID <span class="text-danger">*</span></label>
                            <span id="Name" class="font-weight-bold text-primary small"></span>
                        </div>
                        @Html.TextBoxFor(n => n.LoginId, new { @class = "form-control", @Placeholder = "Enter Login ID", @onchange = "getName()", @style="height: 45px;" })
                    </div>
                    <div class="col-md-4 mb-4">
                        <label class="font-weight-bold text-dark mb-1">Account Head <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.AccountId, new SelectList(ViewBag.ddlHead, "Value", "Text"), new { @class = "form-control", @style="height: 45px;" })
                    </div>
                    <div class="col-md-4 mb-4">
                        <label class="font-weight-bold text-dark mb-1"><i class="far fa-calendar-alt mr-1"></i> Transaction Date <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(n => n.TransactionDate, new { @class = "form-control", @Placeholder = "dd/mm/yyyy", @Readonly="readonly", @style="height: 48px;" })
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-4">
                        <label class="font-weight-bold text-dark mb-1">Amount <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(n => n.Amount, new { @class = "form-control", @Placeholder = "0.00", @onkeypress = "return isNumber(event)", @style="height: 45px;" })
                    </div>
                    <div class="col-md-4 mb-4">
                        <label class="font-weight-bold text-dark mb-1">Payment Mode <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.PaymentMode, new SelectList(ViewBag.ddlPaymentMode, "Value", "Text"), new { @class = "form-control", @onchange = "return CheckPayMode()", @style="height: 45px;" })
                    </div>
                    <div class="col-md-4 mb-4">
                        <label class="font-weight-bold text-dark mb-1">Narration / Remarks <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(n => n.Narration, new { @class = "form-control", @Placeholder = "Enter expense description...", @style="height: 45px;" })
                    </div>
                </div>

                <!-- Conditional Bank Section -->
                <div class="bg-light rounded p-4 mb-4 border animate-up" id="divPaymentMode" style="display: none">
                    <h6 class="font-weight-bold text-info mb-4 border-bottom pb-2">
                        <i class="fas fa-university mr-2"></i> Bank Transaction Information
                    </h6>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <label class="small font-weight-bold">Transaction / Cheque No <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.TransactionNumber, new { @class = "form-control", @Placeholder = "Enter Number", @maxlength = "50", @style="height: 40px;" })
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="small font-weight-bold">Transaction Date <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.ChequeDate, new { @class = "form-control", @Placeholder = "dd/mm/yyyy", @Readonly = "readonly", @style="height: 40px;" })
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="small font-weight-bold">Bank Name <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.BankName, new { @class = "form-control", @maxlength = "100", @Placeholder = "Enter Bank Name", @style="height: 40px;" })
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="small font-weight-bold">Bank Branch <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.BankBranch, new { @class = "form-control", @maxlength = "100", @Placeholder = "Enter Branch", @style="height: 40px;" })
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 text-center mt-3">
                        <button type="submit" class="btn btn-success btn-lg px-5 shadow-sm" name="Save" id="Save" value="Save" onclick="return validateform();">
                            <i class="fas fa-save mr-2"></i> Save Expense Record
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
@section Script{
    <script type="text/javascript" src="../../js/bootstrap-datepicker (1).js" charset="UTF-8"></script>

    <script>
        $(document).ready(function () {
            $("#divload").css({ 'display': 'none' });
        });

        //$('#TransactionDate').datepicker({
        //    dateFormat: 'dd/mm/yy',
        //    changeYear: true,
        //    changeMonth: true,
        //    maxDate: 0
        //});

        //$('#TransactionDate').datetimepicker({
        //    language: 'en',
        //    weekStart: 1,
        //    todayBtn: 1,
        //    autoclose: 1,
        //    todayHighlight: 1,
        //    startView: 2,
        //    minView: 2,
        //    forceParse: 0,
        //    format: 'dd/mm/yyyy'
        //});

        $('#TransactionDate').datepicker({
            dateFormat: 'dd/mm/yy',
            maxDate: 0,
            changeYear: true,
            changeMonth: true
        });

        $('#ChequeDate').datepicker({
            dateFormat: 'dd/mm/yy',
            changeYear: true,
            changeMonth: true,
            maxDate: 0
        });

        function isNumber(evt) {
            var charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode != 46 && charCode > 31
                && (charCode < 48 || charCode > 57))
                return false;

            return true;
        }
        function getName() {
            $("#divload").css({ 'display': '' });
            var sponsorID = $('#LoginId').val();
            $.ajax({
                url: '/Admin/GetNameForExpense', type: 'post', dataType: 'json',
                data: { 'LoginId': sponsorID },
                success: function (data) {
                    $("#divload").css({ 'display': 'none' });
                    if (data.Result == "yes") {
                        $("#Name").text(data.sponsorName);



                    }
                    else if (data.Result == "no") {
                        $("#Name").text('');
                        $("#sponsorName").addClass('errortext');
                        $("#LoginId").addClass('errortext');

                        $('#LoginId').focus();
                        $('#LoginId').val('');
                        alert("Invalid LoginId");
                    }
                }

            });
        }
        function CheckPayMode() {
            debugger
            if ($('#PaymentMode').val() != '1' && $('#PaymentMode').val() != '7' && $('#PaymentMode').val() != '8') {
                $("#divPaymentMode").show();

            }

            else {
                $("#divPaymentMode").hide();
            }

        }
        function validateform() {
            $(".errortext").removeClass("errortext");
            if ($('#LoginId').val() == '') {
                $("#LoginId").addClass('errortext');
                $('#LoginId').focus();
                return false;
            }
            if ($('#AccountId').val() == '0') {
                $("#AccountId").addClass('errortext');
                $('#AccountId').focus();
                return false;
            }
            if ($('#TransactionDate').val() == '') {
                $("#TransactionDate").addClass('errortext');
                $('#TransactionDate').focus();
                return false;
            }
            if ($('#Amount').val() == '') {
                $("#Amount").addClass('errortext');
                $('#Amount').focus();
                return false;
            }
            if ($('#Amount').val() == '0') {
                $("#Amount").addClass('errortext');
                $('#Amount').focus();
                return false;
            }
            if ($('#Narration').val() == '') {
                $("#Narration").addClass('errortext');
                $('#Narration').focus();
                return false;
            }
            if ($('#PaymentMode').val() == '0') {
                $("#PaymentMode").addClass('errortext');
                $('#PaymentMode').focus();
                return false;
            }
        }
    </script>

    <script type="text/javascript">

        function GetSubHead() {
            debugger;

            var hdtype = $("#HeadType").val();
            $.ajax({
                type: "POST",
                url: "/Admin/getAccountSubHeadnew",
                data: { "headtype": hdtype },
                success: function (data) {

                    /* alert(data);*/


                    //var s = '<option value="">--Select--</option>';
                    //for (var i = 0; i < data.length; i++) {
                    //    s += '<option value="' + data[i].Value + '">' + data[i].Text + '</option>';
                    //}
                    //$("#AccountId").html(s);

                    //alert(data.d);
                    //$.each(data.d, function (data, value) {

                    //    $("#AccountId").append($("<option></option>").val(value.Pk_SubHeadId).html(value.SubAccounthead));
                    //})

                    $.each(data, function (value) {
                        $("#AccountId").append($("<option></option>").val(value.Pk_SubHeadId).html(value.SubAccounthead));

                        alert("hellow");
                    });


                }
            });
        };
    </script>
}
