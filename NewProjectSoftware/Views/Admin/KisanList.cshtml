@model RealEstateRegalSpace.Models.Plot

@{
    ViewBag.Title = "KisanList";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}


<div class="wrapper">
    <div class="container-fluid">
        <!-- Page-Title -->
        <div class="page-title-box mb-4">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h4 class="page-title">Kisan List</h4>
                </div>
                
            </div>
            <!-- end row -->
        </div>
        <div class="row gutters table-responsive">
            <table id="basicExample" class="table table-striped table-bordered nowrap">
                <thead>
                    <tr>
                        <th>Kisan Code</th>
                        <th>Name</th>
                        <th>Khasra No</th>
                        <th>Area</th>
                        <th>Rate</th>
                        <th>Total Amount</th>
                        <th>Paid Amount</th>
                        <th>Balance</th>
                        <th>Action</th>

                    </tr>
                </thead>
                <tbody>
                    @if (Model != null)
                    {
                        if (Model.kisanList != null)
                        {
                            if (Model.kisanList.Rows.Count > 0)
                            {
                                for (int i = 0; i <= Model.kisanList.Rows.Count - 1; i++)
                                {
                                    <tr>
                                        <td>@Model.kisanList.Rows[i]["KisanCode"].ToString()</td>
                                        <td>@Model.kisanList.Rows[i]["Name"].ToString()</td>

                                        <td>@Model.kisanList.Rows[i]["KhadraNo"].ToString()</td>

                                        <td>
                                            @Model.kisanList.Rows[i]["Area"].ToString()

                                        </td>
                                        <td>@Model.kisanList.Rows[i]["Rate"].ToString()</td>
                                        <td>@Model.kisanList.Rows[i]["TotalAmount"].ToString()</td>
                                        <td>@Model.kisanList.Rows[i]["PaidAmount"].ToString()</td>
                                        <td>@Model.kisanList.Rows[i]["Balance"].ToString()</td>
                                        <td>
                                            @* <a class="btn btn-danger btn-sm" href="/Admin/DeleteKisan?id=@Model.kisanList.Rows[i]["Id"].ToString()" onclick="return confirm('Are you sure you wish to delete this Kisan?');">Delete</a>*@

                                            <a class="btn btn-info btn-sm" href="/Admin/Kisan?id=@Model.kisanList.Rows[i]["Id"].ToString()">Edit</a>

                                            <a class="btn btn-primary btn-sm" href="/Admin/PayNow?id=@Model.kisanList.Rows[i]["Id"].ToString()">Pay Amount</a>

                                            <a class="btn btn-success btn-sm" href="/Admin/GetKisanLedger?id=@Model.kisanList.Rows[i]["Id"].ToString()">View Details</a>
                                        </td>

                                    </tr>
                                }

                            }
                        }
                    }
                </tbody>
            </table>
        </div>
        </div>

    </div>


<script>
    function fn_showPWD(id, pwd) {
        if ($('#' + id).html() != '******') {
            $('#' + id).html('******');
        }
        else {
            $('#' + id).html(pwd);
        }
    }
</script>
<script src="../../assets/js/jquery.min.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>




<script>
    $(document).ready(function () {
        $("#divload").css({ 'display': 'none' });
    });
</script>
