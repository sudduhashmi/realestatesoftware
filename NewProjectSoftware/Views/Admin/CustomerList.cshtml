@model RealEstateRegalSpace.Models.Customer
@{
    ViewBag.Title = "CustomerList";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
@using (Html.BeginForm("CustomerList", "Admin", FormMethod.Post, new { @id = "form1" }))
{
    <div class="container-fluid">
        <!-- Page-Title -->
        <div class="page-title-box">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h4 class="page-title">Customer Management</h4>
                </div>
            </div>
        </div>

        <!-- Filter Card -->
        <div class="wizard-card animate-up">
            <div class="card-header-premium">
                <i class="fas fa-filter mr-2"></i> Search & Filter
            </div>
            <div class="p-4">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Customer LoginId</label>
                        @Html.TextBoxFor(m => m.CustomerLoginID, new { @class = "form-control", @Placeholder = "Enter LoginID", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Customer Name</label>
                        @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control", @Placeholder = "Enter Name", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Associate Id</label>
                        @Html.TextBoxFor(m => m.AssociateID, new { @class = "form-control", @Placeholder = "Enter Associate ID", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Associate Name</label>
                        @Html.TextBoxFor(m => m.AssociateName, new { @class = "form-control", @Placeholder = "Enter Name", @style="height: 45px;" })
                    </div>
                </div>
                <div class="row align-items-end mt-2">
                    <div class="col-md-4 mb-3">
                        <label class="font-weight-bold text-dark">Joining From Date</label>
                        @Html.TextBoxFor(m => m.JoiningFromDate, new { @class = "form-control", @Placeholder = "dd/mm/yyyy", @style="height: 45px;" })
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="font-weight-bold text-dark">Joining To Date</label>
                        @Html.TextBoxFor(m => m.JoiningToDate, new { @class = "form-control", @Placeholder = "dd/mm/yyyy", @style="height: 45px;" })
                    </div>
                    <div class="col-md-4 mb-3">
                        <button type="submit" class="btn btn-primary btn-block shadow-sm" style="height: 45px;" name="btnSearchCustomer" value="Search">
                            <i class="fas fa-search mr-1"></i> Search Customers
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Customer Table Card -->
        <div class="wizard-card animate-up mt-4">
            <div class="card-header-premium secondary">
                <i class="fas fa-address-book mr-2"></i> Customer Directory
            </div>
            <div class="p-0">
                <div class="table-responsive">
                    <table id="example23" class="table table-hover mb-0 custom-table text-nowrap">
                        <thead class="bg-light">
                            <tr>
                                <th>S No.</th>
                                <th>Customer ID</th>
                                <th>Customer Name</th>
                                <th>Password</th>
                                <th>Associate ID</th>
                                <th>Associate Name</th>
                                <th>JoiningDate</th>
                                <th>Mobile Number</th>
                                <th>Email</th>
                                <th>Pan</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.ListCust != null)
                            {
                                int i = 1;
                                foreach (var Item in Model.ListCust)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td class="font-weight-bold text-primary">@Item.LoginID</td>
                                        <td class="text-dark font-weight-bold">@Item.FirstName @Item.LastName</td>
                                        <td><code class="text-primary font-weight-bold">@Item.Password</code></td>
                                        <td>@Item.sponserId</td>
                                        <td>@Item.sponsorName</td>
                                        <td><i class="fas fa-calendar-alt mr-1 small"></i> @Item.JoiningDate</td>
                                        <td><i class="fas fa-phone mr-1 small"></i> @Item.Contact</td>
                                        <td>@Item.Email</td>
                                        <td><span class="badge badge-light border">@Item.PanNo</span></td>
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a href="/Admin/CustomerRegistration?UserID=@Item.EncryptKey" class="btn btn-sm btn-outline-success mr-2 rounded-circle" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="/Admin/DeleteCustomer?UserID=@Item.UserID" class="btn btn-sm btn-outline-danger rounded-circle" onclick="return confirm('Are you sure you want to delete this Customer?');" title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

}
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">

<script>


    $('#JoiningFromDate').datepicker({
        dateFormat: 'dd/mm/yy',
        changeYear: true,
        changeMonth: true
    });
    $('#JoiningToDate').datepicker({
        dateFormat: 'dd/mm/yy',
        changeYear: true,
        changeMonth: true
    });

</script>

