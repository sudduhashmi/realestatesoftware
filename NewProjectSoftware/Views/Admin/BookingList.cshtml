@model RealEstateRegalSpace.Models.Plot

@{
    ViewBag.Title = "BookingList";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}


@using (Html.BeginForm("BookingList", "Admin", FormMethod.Post, new { @id = "form1" }))
{
    <div class="container-fluid">
        <!-- Page-Title -->
        <div class="page-title-box">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h4 class="page-title">Booking Management</h4>
                </div>
            </div>
        </div>

        <!-- Filter Card -->
        <div class="wizard-card animate-up">
            <div class="card-header-premium">
                <i class="fas fa-filter mr-2"></i> Search & Filter
            </div>
            <div class="p-4">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Customer ID</label>
                        @Html.TextBoxFor(m => m.CustomerID, new { @class = "form-control", @Placeholder = "Search by Customer ID", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Associate ID</label>
                        @Html.TextBoxFor(m => m.AssociateID, new { @class = "form-control", @Placeholder = "Search by Associate ID", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark"><i class="far fa-calendar-alt mr-1"></i> From Date</label>
                        @Html.TextBoxFor(m => m.FromDate, new { @class = "form-control", @Placeholder = "dd/mm/yyyy", @readonly = "readonly", @style="height: 48px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark"><i class="far fa-calendar-alt mr-1"></i> To Date</label>
                        @Html.TextBoxFor(m => m.ToDate, new { @class = "form-control", @Placeholder = "dd/mm/yyyy", @readonly = "readonly", @style="height: 48px;" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Booking No</label>
                        @Html.TextBoxFor(m => m.BookingNumber, new { @class = "form-control", @Placeholder = "Booking No", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Select Site</label>
                        @Html.DropDownListFor(m => m.SiteID, new SelectList(ViewBag.ddlSite, "Value", "Text"), new { @class = "form-control", @onchange = "return onSiteChange();", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Select Sector</label>
                        @Html.DropDownListFor(m => m.SectorID, new SelectList(ViewBag.ddlSector, "Value", "Text"), new { @class = "form-control", @onchange = "return onSectorChange();", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Select Block</label>
                        @Html.DropDownListFor(m => m.BlockID, new SelectList(ViewBag.ddlBlock, "Value", "Text"), new { @class = "form-control", @style="height: 45px;" })
                    </div>
                </div>
                <div class="row align-items-end mt-2">
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Plot Number</label>
                        @Html.TextBoxFor(m => m.PlotNumber, new { @class = "form-control", @Placeholder = "Plot Number", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="d-block text-white">&nbsp;</label>
                        <button type="submit" class="btn btn-primary btn-block shadow-sm" style="height: 45px;" id="btnSearch" name="Search" value="Search">
                            <i class="fas fa-search mr-1"></i> Get Booking List
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Card -->
        <div class="wizard-card animate-up mt-4">
            <div class="card-header-premium secondary">
                <i class="fas fa-list mr-2"></i> Bookings Overview
            </div>
            <div class="p-0">
                <div class="table-responsive">
                    <table id="example23" class="table table-hover mb-0 custom-table text-nowrap">
                        <thead class="bg-light">
                            <tr>
                                <th>S No.</th>
                                <th>Booking No</th>
                                <th>Customer Info</th>
                                <th>Associate Info</th>
                                <th>Plot Details</th>
                                <th>Rate/Area</th>
                                <th>Amount/Discount</th>
                                <th>PLC</th>
                                <th>Net Amount</th>
                                <th>Booking Date</th>
                                <th>Booking Amt</th>
                                <th>Payment Plan</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.lstPlot != null)
                            {
                                int i = 1;
                                foreach (var Item in Model.lstPlot)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td class="font-weight-bold text-primary">@Item.BookingNumber</td>
                                        <td>
                                            <div class="font-weight-bold text-dark">@Item.CustomerName</div>
                                            <small class="text-muted">ID: @Item.CustomerLoginID</small>
                                        </td>
                                        <td>
                                            <div class="text-dark">@Item.AssociateName</div>
                                            <small class="text-info">ID: @Item.AssociateLoginID</small>
                                        </td>
                                        <td><span class="badge badge-light border">@Item.PlotNumber</span></td>
                                        <td>
                                            <small class="text-muted d-block">Rate: @Item.PlotRate</small>
                                            <small class="text-muted">Area: @Item.PlotArea</small>
                                        </td>
                                        <td>
                                            <div class="text-dark">@Item.PlotAmount</div>
                                            <small class="text-danger">Disc: @Item.Discount</small>
                                        </td>
                                        <td>@Item.PLCAmount</td>
                                        <td class="font-weight-bold text-success">@Item.NetPlotAmount</td>
                                        <td><i class="fas fa-calendar-alt mr-1 small text-muted"></i> @Item.BookingDate</td>
                                        <td>@Item.BookingAmount</td>
                                        <td><span class="badge badge-soft-info">@Item.PaymentPlan</span></td>
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a href="/Admin/PlotBooking?PK_BookingId=@Item.PK_BookingId" class="btn btn-sm btn-outline-primary mr-2 rounded-circle" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                @if (Item.PaymentPlan != "Full Payment Plan" && Item.IsEMICalculated == "0")
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-success rounded-circle" onclick="return createEMI('@Item.PK_BookingId');" title="Create EMI">
                                                        <i class="fas fa-calculator"></i>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="modal fade" id="myModal" role="dialog" style="display: none">
        <div class="modal-dialog modal-dialog-centered">
            <!-- Modal content-->
            <div class="modal-content border-0 shadow-lg" style="border-radius: 15px; overflow: hidden;">
                <div class="modal-header bg-primary text-white py-3">
                    <h5 class="modal-title"><i class="fas fa-calculator mr-2"></i> Create EMI Plan</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" onclick="closeModal();">&times;</button>
                </div>
                <div class="modal-body p-4">
                    <div class="row align-items-end">
                        <input type="hidden" id="PK_BookingId" />
                        <div class="col-md-8">
                            <label class="font-weight-bold text-dark">Number of EMIs</label>
                            <input type="text" id="noofEMI" class="form-control" placeholder="Enter Total EMIs" style="height: 45px;" />
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary btn-block shadow-sm" onclick="return EMICreate();" style="height: 45px;">
                                <i class="fas fa-plus-circle mr-1"></i> Create
                            </button>
                        </div>
                    </div>
                    <div class="mt-3 text-muted small italic">
                        <i class="fas fa-info-circle mr-1"></i> This will generate the installment schedule for the selected booking.
                    </div>
                </div>
            </div>
        </div>
    </div>

}

@section Script {
    <script>
    function createEMI(PK_BookingId) {
        $("#myModal").modal('show');

        $('#PK_BookingId').val(PK_BookingId);

    }
    function EMICreate() {
        $.ajax({
            url: '/Admin/CreateEMI', type: 'post', dataType: 'json',
            data: { 'PK_BookingId': $('#PK_BookingId').val(), noofEMI: $('#noofEMI').val() },
            success: function (data) {
                $("#divload").css({ 'display': 'none' });

            }

        });

    }
    $('#FromDate').datepicker({
        dateFormat: 'dd/mm/yy',
        changeYear: true,
        changeMonth: true
    });
    $('#Todate').datepicker({
        dateFormat: 'dd/mm/yy',
        changeYear: true,
        changeMonth: true
    });
    function onSiteChange() {
        $("#divload").css({ 'display': '' });
        var value = $('#SiteID').val();
        var values = $('#SectorID').val();
        var tr = [];
        $.ajax({
            url: "/Masters/GetSiteDetails",
            Type: "Get",
            DataType: "JSON",
            data: { SiteID: value },
            success: function (data) {
                $("#divload").css({ 'display': 'none' });
                var j = 1;
                if (data.Result == "yes") {

                    $("#SectorID").html(""); // clear before appending new list
                    $("#SectorID").empty();
                    $("#SectorID").append(
                        $('<option></option>').val(0).html('Select Sector'));
                    $.each(data.ddlSector, function (index, Sectorcount) {
                        $("#SectorID").append(
                            $('<option></option>').val(Sectorcount.Value).html(Sectorcount.Text));

                    });
                }
                else {
                    $("#SectorID").empty();

                }
            }

        });

    }

    function onSectorChange() {

        $("#divload").css({ 'display': '' });
        var siteID = $('#SiteID').val();
        var sectorID = $('#SectorID').val();
        $.ajax({
            url: '/Masters/GetBlockList', type: 'post', dataType: 'json',
            data: { 'SiteID': siteID, 'sectorID': sectorID },
            success: function (data) {
                $("#divload").css({ 'display': 'none' });
                $("#BlockID").html(""); // clear before appending new list
                $("#BlockID").empty();
                $("#BlockID").append(
                    $('<option></option>').val(0).html('Select Block'));
                $.each(data.lstBlock, function (index, BlockCount) {
                    $("#BlockID").append(
                        $('<option></option>').val(BlockCount.Value).html(BlockCount.Text));
                });

            }

        });
    }
</script>
}

