@model RealEstateRegalSpace.Models.Plot

@{
    ViewBag.Title = "PlotRegistry";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}


@using (Html.BeginForm("PlotRegistry", "Admin", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
{    <div class="container-fluid">
        <!-- Page-Title -->
        <div class="page-title-box">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h4 class="page-title">Plot Registry Management</h4>
                </div>
            </div>
        </div>

        <!-- Search Card -->
        <div class="wizard-card animate-up">
            <div class="card-header-premium">
                <i class="fas fa-search mr-2"></i> Find Plot for Registry
            </div>
            <div class="p-4">
                <div class="row align-items-end">
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Select Site <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.SiteID, new SelectList(ViewBag.ddlSite, "Value", "Text"), new { @class = "form-control", @onchange = "return onSiteChange();", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Select Sector <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.SectorID, new SelectList(ViewBag.ddlSector, "Value", "Text"), new { @class = "form-control", @onchange = "return onSectorChange();", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Select Block <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.BlockID, new SelectList(ViewBag.ddlBlock, "Value", "Text"), new { @class = "form-control", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Plot Number <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.PlotNumber, new { @class = "form-control", @Placeholder = "Plot Number", @style="height: 45px;" })
                        @Html.HiddenFor(m => m.PlotID)
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="d-block text-white">&nbsp;</label>
                        <button type="submit" name="GetDetails" value="Search" id="GetDetails" class="btn btn-primary btn-block shadow-sm" style="height: 45px;" onclick="return GetDetails();">
                            <i class="fas fa-search mr-1"></i> Search
                        </button>
                    </div>
                </div>
                @if (TempData["PlotRegistry"] != null)
                {
                    <div class="alert alert-soft-danger border-0 mb-0 mt-2">
                        <i class="fas fa-exclamation-circle mr-2"></i> @TempData["PlotRegistry"]
                    </div>
                }
            </div>
        </div>

        @if (Model != null && Model.AssociateLoginID != null)
        {
            <!-- Registry Details Card -->
            <div class="wizard-card animate-up mt-4" id="Details1">
                <div class="card-header-premium secondary">
                    <i class="fas fa-file-contract mr-2"></i> Allotment & Registry Information
                </div>
                <div class="p-4">
                    <!-- Summary Info -->
                    <div class="row">
                        <div class="col-md-3 mb-3 border-right">
                            <label class="small text-muted font-weight-bold text-uppercase">Associate Details</label>
                            <div class="font-weight-bold text-dark">@Model.AssociateName</div>
                            <div class="text-info small">ID: @Model.AssociateLoginID</div>
                        </div>
                        <div class="col-md-3 mb-3 border-right">
                            <label class="small text-muted font-weight-bold text-uppercase">Customer Details</label>
                            <div class="font-weight-bold text-dark">@Model.CustomerName</div>
                            <div class="text-primary small">ID: @Model.CustomerLoginID</div>
                        </div>
                        <div class="col-md-3 mb-3 border-right">
                            <label class="small text-muted font-weight-bold text-uppercase">Plot Stats</label>
                            <div class="small">Rate: <span class="font-weight-bold">@Model.PlotRate</span></div>
                            <div class="small">Area: <span class="font-weight-bold">@Model.PlotArea</span></div>
                            <div class="small">Total: <span class="font-weight-bold text-success">@Model.PlotAmount</span></div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label class="small text-muted font-weight-bold text-uppercase">Financials</label>
                            <div class="small">Paid: <span class="font-weight-bold text-primary">@Model.PaidAmount</span></div>
                            <div class="small">Balance: <span class="font-weight-bold text-danger">@Model.Balance</span></div>
                            <div><span class="badge badge-soft-info">Plan: @Model.PlanName</span></div>
                        </div>
                    </div>

                    <hr class="my-4 border-dashed" />

                    <!-- Registry Form -->
                    <div class="bg-light p-4 rounded-lg border border-primary-soft">
                        <h6 class="font-weight-bold text-primary mb-4"><i class="fas fa-pen-nib mr-2"></i> Registry Submission Details</h6>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="font-weight-bold text-dark">Khasra No <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.KhadraNo, new { @class = "form-control", @Placeholder = "Enter Khasra No", @style="height: 45px;" })
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="font-weight-bold text-dark">Registree No <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.RegistreeNo, new { @class = "form-control", @Placeholder = "Enter Registree No", @style="height: 45px;" })
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="font-weight-bold text-dark">Registree Date <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => m.RegistrationDate, new { @class = "form-control", @Placeholder = "dd/mm/yyyy", @readonly="readonly", @style="height: 45px;" })
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12 text-center">
                                @Html.HiddenFor(m => m.PK_BookingId)
                                <button type="submit" name="SaveRegistry" value="Save" id="SaveRegistry" class="btn btn-success btn-lg px-5 shadow-sm" onclick="return validateform();">
                                    <i class="fas fa-save mr-2"></i> Complete Registry Process
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

}
<script src="../../Scripts/jquery-1.10.2.min.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">


<script>
    $(document).ready(function () {
        $("#divload").css({ 'display': 'none' });
    });

    $('#RegistrationDate').datepicker({
        dateFormat: 'dd/mm/yy',
        changeYear: true,
        changeMonth: true
    });

    function validateform() {
        $(".errortext").removeClass("errortext");

        if ($('#KhadraNo').val() == '') {
            $("#KhadraNo").addClass('errortext');
            $('#KhadraNo').focus();
            return false;
        }
        if ($('#RegistreeNo').val() == '') {
            $("#RegistreeNo").addClass('errortext');
            $('#RegistreeNo').focus();
            return false;
        }
        if ($('#RegistrationDate').val() == '') {
            $("#RegistrationDate").addClass('errortext');
            $('#RegistrationDate').focus();
            return false;
        }
        return true;
    }

    function isNumberOrDecimal(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }

    function onlyAlphabets(e, t) {
        try {
            if (window.event) {
                var charCode = window.event.keyCode;
            }
            else if (e) {
                var charCode = e.which;
            }
            else { return true; }
            if ((charCode > 64 && charCode < 91) || (charCode > 96 && charCode < 123))
                return true;
            else
                return false;
        }
        catch (err) {
            alert(err.Description);
        }
    }

    function onSiteChange() {
        $("#divload").css({ 'display': '' });
        var value = $('#SiteID').val();
        var values = $('#SectorID').val();
        var tr = [];
        $.ajax({
            url: "/Masters/GetSiteDetails",
            Type: "Get",
            DataType: "JSON",
            data: { SiteID: value },
            success: function (data) {
                $("#divload").css({ 'display': 'none' });
                var j = 1;
                if (data.Result == "yes") {
                    $('#Rate').val(data.Rate);
                    $("#SectorID").html(""); // clear before appending new list
                    $("#SectorID").empty();
                    $("#SectorID").append(
                        $('<option></option>').val(0).html('Select Sector'));
                    $.each(data.ddlSector, function (index, Sectorcount) {
                        $("#SectorID").append(
                            $('<option></option>').val(Sectorcount.Value).html(Sectorcount.Text));

                    });
                }
                else {
                    $("#SectorID").empty();
                    $('#Rate').val('');
                }
            }

        });

    }

    function onSectorChange() {

        $("#divload").css({ 'display': '' });
        var siteID = $('#SiteID').val();
        var sectorID = $('#SectorID').val();
        $.ajax({
            url: '/Masters/GetBlockList', type: 'post', dataType: 'json',
            data: { 'SiteID': siteID, 'sectorID': sectorID },
            success: function (data) {
                $("#divload").css({ 'display': 'none' });
                $("#BlockID").html(""); // clear before appending new list
                $("#BlockID").empty();
                $("#BlockID").append(
                    $('<option></option>').val(0).html('Select Block'));
                $.each(data.lstBlock, function (index, BlockCount) {
                    $("#BlockID").append(
                        $('<option></option>').val(BlockCount.Value).html(BlockCount.Text));
                });

            }

        });
    }

    function GetDetails() {
        $("#divload").css({ 'display': '' });

        if ($('#SiteID').val() == '0') {
            $("#SiteID").addClass('errortext');
            $('#SiteID').focus();
            return false;
        }

        if ($('#SectorID').val() == '0') {
            $("#SectorID").addClass('errortext');
            $('#SectorID').focus();
            return false;
        }

        if ($('#BlockID').val() == '0') {
            $("#BlockID").addClass('errortext');
            $('#BlockID').focus();
            return false;
        }

        if ($('#PlotNumber').val() == '') {
            $("#PlotNumber").addClass('errortext');
            $('#PlotNumber').focus();
            return false;
        }


    }



    function Validate() {
        $(".errortext").removeClass("errortext");

        if ($('#SiteID').val() == '') {
            $("#SiteID").addClass('errortext');
            $('#SiteID').focus();
            return false;
        }
        if ($('#BookingNumber').val() == '0') {
            $("#BookingNumber").addClass('errortext');
            $('#BookingNumber').focus();
            return false;
        }

        return true;
    }

    function validatePayAmount() {
        debugger
        var totalAmt = $('#netPlotAmt').text();
        var paidAmt = $('#Payamt').text();
        var checkAmt = (Number)(totalAmt) - (Number)(paidAmt);
        var payAmt = $('#PaidAmount').val();
        if ((Number)(payAmt) > (Number)(checkAmt)) {
            alert('Pay Amount cannot be greater than Remaining Amount.\nRemaining Amount is : Rs.' + checkAmt);
            $("#PaidAmount").val("");
            $("#PaidAmount").addClass('errortext');
            $('#PaidAmount').focus();
        }
        else {
            $("#PaidAmount").removeClass('errortext');
        }
    }
</script>
