@model RealEstateRegalSpace.Models.Plot

@{
    ViewBag.Title = "Kisan";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@using (Html.BeginForm("Kisan", "Admin", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
{

    <div class="wrapper">
        <div class="container-fluid">
            <!-- Page-Title -->
            <div class="page-title-box mb-4">
                <div class="row align-items-center">
                    <div class="col-sm-6">
                        <h4 class="page-title">Kisan Registration</h4>
                    </div>
                    
                </div>
                <!-- end row -->
            </div>
            <div class="card">
                <div class="card-body">
                    <div class="row mb-3">
                        @*<div class="col-sm-2">
                                Kisan Code <span style="color: red">*</span>
                                @Html.TextBoxFor(m => m.KisanCode, new { @class = "form-control", @Placeholder = "KisanCode", @readonly = "disabled" })
                            </div>*@
                        <div class="col-sm-2">
                            Khasra No <span style="color:red">*</span>
                            @Html.TextBoxFor(m => m.KhadraNo, new { @class = "form-control", @Placeholder = "Khasra No" })
                        </div>
                        <div class="col-sm-3">
                            Name <span style="color: red">*</span>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", @Placeholder = "Name" })
                        </div>

                        <div class="col-sm-5">
                            Address <span style="color: red">*</span>
                            @Html.TextBoxFor(m => m.Address, new { @class = "form-control", @Placeholder = "Address" })
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-2">
                            Area <span style="color:red">*</span>
                            @Html.TextBoxFor(m => m.PlotArea, new { @class = "form-control", @Placeholder = "Area", @onkeypress = "return isNumberOrDecimal(event);", @onchange = "return gettotalamount();" })
                        </div>
                        <div class="col-sm-2">
                            Rate <span style="color:red">*</span>
                            @Html.TextBoxFor(m => m.PlotRate, new { @class = "form-control", @Placeholder = "Rate", @onkeypress = "return isNumberOrDecimal(event);", @onchange = "return gettotalamount();" })
                        </div>
                        <div class="col-sm-3">
                            Total Amount
                            @Html.TextBoxFor(m => m.PlotAmount, new { @class = "form-control", @Placeholder = "Total Amount", @readonly = "disabled" })
                        </div>
                        <div class="col-sm-3">
                            Paid Amount <span style="color: red">*</span>
                            @Html.TextBoxFor(m => m.PaidAmount, new { @class = "form-control", @Placeholder = "Paid Amount", @onkeypress = "return isNumberOrDecimal(event);", @maxlength = "10", @onchange = "return getbalance();" })
                        </div>
                        <div class="col-sm-2">
                            Balance <span style="color: red">*</span>
                            @Html.TextBoxFor(m => m.Balance, new { @class = "form-control", @Placeholder = "Balance", @disabled = "disabled" })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-12">
                            Narration <span style="color: red">*</span>
                            @Html.TextAreaFor(m => m.Narration, new { @class = "form-control", @Placeholder = "Narration" })
                        </div>

                    </div>
                    <div class="row mb-3">

                        <div class="col-sm-3">
                            Payment Date <span style="color: red">*</span>
                            @*@Html.TextBoxFor(m => m.PaymentDate, new { @class = "form-control", @Placeholder = "PaymentDate", @readonly = "readonly" })*@
                            @Html.TextBoxFor(m => m.PaymentDate, new { @class = "form-control", @Placeholder = "PaymentDate" })
                        </div>
                        <div class="col-sm-3">
                            Payment Mode <span style="color: red">*</span>
                            @Html.DropDownListFor(m => m.PaymentMode, new SelectList(ViewBag.ddlPaymentMode, "Value", "Text"), new { @class = "form-control", @onchange = "return CheckPayMode()" })
                        </div>

                    </div>
                    <div class="row" id="divPaymentMode" style="display: none">
                        <div class="col-md-3">
                            <div class="form-group">
                                Cheque/Transaction Number <span style="color: red">*</span>
                                @Html.TextBoxFor(m => m.TransactionNumber, new { @class = "form-control", @Placeholder = "Cheque/Transaction Number", @maxlength = "50" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                Cheque/Transaction Date <span style="color: red">*</span>
                                @Html.TextBoxFor(m => m.TransactionDate, new { @class = "form-control", @Placeholder = "Cheque/Transaction Date", @Readonly = "readonly" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                Bank Name <span style="color: red">*</span>
                                @Html.TextBoxFor(m => m.BankName, new { @class = "form-control", @maxlength = "100", @Placeholder = "Bank Name" })
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                Bank Branch <span style="color: red">*</span>
                                @Html.TextBoxFor(m => m.BankBranch, new { @class = "form-control", @maxlength = "100", @Placeholder = "Bank Branch" })
                                @Html.HiddenFor(m => m.Fk_UserId)
                            </div>

                        </div>
                    </div>

                    <br />
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                @if (Model.Fk_UserId == null)
                                {
                                    <input class="btn btn-success pull-right" type="submit" onclick="return validateform();" value="Save" id="btnSave" name="btnSave" />
                                }
                                else
                                {

                                    <input class="btn btn-success pull-left" type="submit" onclick="return validateformupdate();" value="Update" id="btnUpdate" name="btnUpdate" />
                                }

                            </div>
                        </div>
                        <br />
                        <a style="color:red">
                            @TempData["KisanRegistration"]

                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

}
<script src="../../Scripts/jquery-1.10.2.min.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">

<script>
    $(document).ready(function () {
        //alert('1');
        $("#divload").css({ 'display': 'none' });
        //alert('a');
        var msg ='@TempData["KisanRegistration"]';
        if (msg == 'Data Saved Successfully') {
            var kisancode ='Kisan Registered Successfully, Kisan Code : ' +'@TempData["KisanCode"]';
            alert(kisancode);
        }

    });
    $('#PaymentDate').datepicker({
        dateFormat: 'dd/mm/yy',
        maxDate: 0,
        changeYear: true,
        changeMonth: true
    });
    $('#TransactionDate').datepicker({
        dateFormat: 'dd/mm/yy',
        maxDate: 0,
        changeYear: true,
        changeMonth: true
    });
</script>
<script>
    function gettotalamount() {
        var plotarea = Number($('#PlotArea').val());
        var totalamount = Number(plotarea) * Number($('#PlotRate').val());
        $('#PlotAmount').val(totalamount);
    }
    function validateform() {
        $(".errortext").removeClass("errortext");
        if ($('#Name').val() == '') {
            $("#Name").addClass('errortext');
            $('#Name').focus();
            $('#Name').val('');
            //   alert("Please Fill Sponsor ID .")
            return false;
        }
        if ($('#KhadraNo').val() == '') {
            $("#KhadraNo").addClass('errortext');
            $('#KhadraNo').focus();
            $('#KhadraNo').val('');
            return false;
        }
        if ($('#PlotArea').val() == '') {
            $("#PlotArea").addClass('errortext');
            $('#PlotArea').focus();
            //  alert("Please Fill First Name .")
            return false;
        }
        if ($('#PlotRate').val() == '') {
            $("#PlotRate").addClass('errortext');
            $('#PlotRate').focus();
            //  alert("Please Fill Mobile Number .")
            return false;
        }
        if ($('#PlotAmount').val() == '') {
            $("#PlotAmount").addClass('errortext');
            $('#PlotAmount').focus();
            //    alert("Please Fill PAN .")
            return false;
        }
        if ($('#PaidAmount').val() == '') {
            $("#PaidAmount").addClass('errortext');
            $('#PaidAmount').focus();
            //    alert("Please Enter Pin Code")
            return false;
        }
        if ($('#PaymentDate').val() == '') {
            $("#PaymentDate").addClass('errortext');
            $('#PaymentDate').focus();
            //    alert("Please Enter Pin Code")
            return false;
        }
        if ($('#PaymentMode').val() == '0') {
            $("#PaymentMode").addClass('errortext');
            $('#PaymentMode').focus();
            //    alert("Please Enter Pin Code")
            return false;
        }
        if ($('#PaymentMode').val() != '1' && $('#PaymentMode').val() != '7' && $('#PaymentMode').val() != '8') {
            if ($('#TransactionNumber').val() == '') {
                $("#TransactionNumber").addClass('errortext');
                $('#TransactionNumber').focus();
                $("#divload").css({ 'display': 'none' });
                return false;
            }
            if ($('#TransactionDate').val() == '') {
                $("#TransactionDate").addClass('errortext');
                $('#TransactionDate').focus();
                $("#divload").css({ 'display': 'none' });
                return false;
            }
            if ($('#PaymentMode').val() != '4' && $('#PaymentMode').val() != '9') {
                if ($('#BankName').val() == '') {
                    $("#BankName").addClass('errortext');
                    $('#BankName').focus();
                    $("#divload").css({ 'display': 'none' });
                    return false;
                }
                if ($('#BankBranch').val() == '') {
                    $("#BankBranch").addClass('errortext');
                    $('#BankBranch').focus();
                    $("#divload").css({ 'display': 'none' });
                    return false;
                }
                // $('#creditdebit').html('Debit To');
            }

        }
        else {
            $('#TransactionNumber').val('');
            $('#TransactionDate').val('');
            $('#BankName').val('');
            $('#BankBranch').val('');
        }
        $("#divload").css({ 'display': '' });
        return true;
    }
    function validateformupdate() {
        $(".errortext").removeClass("errortext");
        if ($('#Name').val() == '') {
            $("#Name").addClass('errortext');
            $('#Name').focus();
            $('#Name').val('');
            //   alert("Please Fill Sponsor ID .")
            return false;
        }
        if ($('#KhadraNo').val() == '') {
            $("#KhadraNo").addClass('errortext');
            $('#KhadraNo').focus();
            $('#KhadraNo').val('');
            return false;
        }
        if ($('#PlotArea').val() == '') {
            $("#PlotArea").addClass('errortext');
            $('#PlotArea').focus();
            //  alert("Please Fill First Name .")
            return false;
        }
        if ($('#PlotRate').val() == '') {
            $("#PlotRate").addClass('errortext');
            $('#PlotRate').focus();
            //  alert("Please Fill Mobile Number .")
            return false;
        }
        if ($('#PlotAmount').val() == '') {
            $("#PlotAmount").addClass('errortext');
            $('#PlotAmount').focus();
            //    alert("Please Fill PAN .")
            return false;
        }
        if ($('#PaidAmount').val() == '') {
            $("#PaidAmount").addClass('errortext');
            $('#PaidAmount').focus();
            //    alert("Please Enter Pin Code")
            return false;
        }

        $("#divload").css({ 'display': '' });
        return true;
    }
    function isNumberOrDecimal(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;
        return true;
    }
    function CheckPayMode() {
        debugger
        if ($('#PaymentMode').val() != '1' && $('#PaymentMode').val() != '7' && $('#PaymentMode').val() != '8') {
            $("#divPaymentMode").show();
            if ($('#PaymentMode').val() == '9') {
                $('#creditdebit').html('Debit To');
            }
            else {
                $('#creditdebit').html('Debit To');
            }
        }

        else {
            $("#divPaymentMode").hide();
        }

    }
    function getbalance() {
        var balance = Number($('#PlotAmount').val()) - Number($('#PaidAmount').val());
        $('#Balance').val(balance);
    }
    function onlyAlphabets(e, t) {
        try {
            if (window.event) {
                var charCode = window.event.keyCode;
            }
            else if (e) {
                var charCode = e.which;
            }
            else { return true; }
            if ((charCode > 64 && charCode < 91) || (charCode > 96 && charCode < 123))
                return true;
            else
                return false;
        }
        catch (err) {
            alert(err.Description);
        }
    }

</script>


