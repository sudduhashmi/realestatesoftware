@model RealEstateRegalSpace.Models.Reports

@{
    ViewBag.Title = "GetLedger";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@using (Html.BeginForm("GetLedger", "Admin", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
{
    <div class="container-fluid">
        <!-- Page-Title -->
        <div class="page-title-box">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h4 class="page-title">Financial Ledger Statement</h4>
                </div>
            </div>
        </div>

        <!-- Filter Card -->
        <div class="wizard-card animate-up">
            <div class="card-header-premium">
                <i class="fas fa-filter mr-2"></i> Select Date Range
            </div>
            <div class="p-4">
                <div class="row align-items-end">
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark"><i class="far fa-calendar-alt mr-1"></i> From Date</label>
                        @Html.TextBoxFor(m => m.FromDate, new { @class = "form-control", @readonly = "readonly", @Placeholder = "dd/mm/yyyy", @style="height: 48px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark"><i class="far fa-calendar-alt mr-1"></i> To Date</label>
                        @Html.TextBoxFor(m => m.Todate, new { @class = "form-control", @readonly = "readonly", @Placeholder = "dd/mm/yyyy", @style="height: 48px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="d-block text-white">&nbsp;</label>
                        <button type="submit" id="btnSearch" name="Search" value="Search" class="btn btn-primary btn-block shadow-sm font-weight-bold" style="height: 48px;">
                            <i class="fas fa-search mr-1"></i> Generate Ledger
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Card -->
        <div class="wizard-card animate-up mt-4">
            <div class="card-header-premium secondary">
                <i class="fas fa-book mr-2"></i> Transaction History
            </div>
            <div class="p-0">
                <div class="table-responsive">
                    <table id="example23" class="table table-hover mb-0 custom-table">
                        <thead>
                            <tr>
                                <th class="text-center">Sr No.</th>
                                <th>Transaction Date</th>
                                <th>Narration / Details</th>
                                <th class="text-right">Credit (In)</th>
                                <th class="text-right">Debit (Out)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.lstDetails != null && Model.lstDetails.Rows.Count > 0)
                            {
                                int j = 1;
                                for (int i = 0; i <= Model.lstDetails.Rows.Count - 1; i++)
                                {
                                    <tr>
                                        <td class="text-center text-muted">@j</td>
                                        <td><i class="fas fa-calendar-alt mr-2 small text-primary"></i> @Model.lstDetails.Rows[i]["TransactionDate"].ToString()</td>
                                        <td class="text-dark small" style="max-width: 300px; white-space: normal;">@Model.lstDetails.Rows[i]["Narration"].ToString()</td>
                                        <td class="text-right font-weight-bold text-success">
                                            ₹ @Model.lstDetails.Rows[i]["CrAmount"].ToString()
                                        </td>
                                        <td class="text-right font-weight-bold text-danger">
                                            ₹ @Model.lstDetails.Rows[i]["DrAmount"].ToString()
                                        </td>
                                    </tr>
                                    j++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted small">No transactions found for the selected period.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Script {
    <script>
        $(document).ready(function () {
            $('#FromDate').datepicker({
                dateFormat: 'dd/mm/yy',
                changeYear: true,
                changeMonth: true
            });
            $('#Todate').datepicker({
                dateFormat: 'dd/mm/yy',
                changeYear: true,
                changeMonth: true
            });
        });
    </script>
}


