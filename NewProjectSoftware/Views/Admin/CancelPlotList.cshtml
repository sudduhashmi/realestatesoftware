@model RealEstateRegalSpace.Models.Reports

@{
    ViewBag.Title = "CancelPlotList";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}



@using (Html.BeginForm("CancelPlotList", "Admin", FormMethod.Post, new { @id = "form1" }))
{
    <div class="container-fluid">
        <!-- Page-Title -->
        <div class="page-title-box">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h4 class="page-title">Cancel Plot Directory</h4>
                </div>
            </div>
        </div>

        <!-- Filter Card -->
        <div class="wizard-card animate-up">
            <div class="card-header-premium">
                <i class="fas fa-filter mr-2"></i> Search & Filter
            </div>
            <div class="p-4">
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Customer ID</label>
                        @Html.TextBoxFor(m => m.LoginId, new { @class = "form-control", @Placeholder = "Search ID", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Associate ID</label>
                        @Html.TextBoxFor(m => m.SponsorId, new { @class = "form-control", @Placeholder = "Search ID", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">From Date</label>
                        @Html.TextBoxFor(m => m.FromDate, new { @class = "form-control", @Placeholder = "dd/mm/yyyy", @readonly = "readonly", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">To Date</label>
                        @Html.TextBoxFor(m => m.Todate, new { @class = "form-control", @Placeholder = "dd/mm/yyyy", @readonly = "readonly", @style="height: 45px;" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Booking No</label>
                        @Html.TextBoxFor(m => m.BookingNumber, new { @class = "form-control", @Placeholder = "Booking No", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Select Site</label>
                        @Html.DropDownListFor(m => m.SiteID, new SelectList(ViewBag.ddlSite, "Value", "Text"), new { @class = "form-control", @onchange = "return onSiteChange();", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Select Sector</label>
                        @Html.DropDownListFor(m => m.SectorID, new SelectList(ViewBag.ddlSector, "Value", "Text"), new { @class = "form-control", @onchange = "return onSectorChange();", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Select Block</label>
                        @Html.DropDownListFor(m => m.BlockID, new SelectList(ViewBag.ddlBlock, "Value", "Text"), new { @class = "form-control", @style="height: 45px;" })
                    </div>
                </div>
                <div class="row align-items-end mt-2">
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold text-dark">Plot Number</label>
                        @Html.TextBoxFor(m => m.PlotNumber, new { @class = "form-control", @Placeholder = "Plot Number", @style="height: 45px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="d-block text-white">&nbsp;</label>
                        <button type="submit" class="btn btn-primary btn-block shadow-sm" style="height: 45px;" id="btnSearch" name="Search" value="Search">
                            <i class="fas fa-search mr-1"></i> Search Records
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table Card -->
        <div class="wizard-card animate-up mt-4">
            <div class="card-header-premium secondary">
                <i class="fas fa-list-alt mr-2"></i> Cancelled Bookings
            </div>
            <div class="p-0">
                <div class="table-responsive">
                    <table id="example23" class="table table-hover mb-0 custom-table">
                        <thead>
                            <tr>
                                <th>S No.</th>
                                <th>Booking No</th>
                                <th>Customer Name</th>
                                <th>Associate Name</th>
                                <th>Plot Details</th>
                                <th>Booking Date</th>
                                <th>Cancel Date</th>
                                <th>Refund Amount</th>
                                <th>Remark</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.lstDetails != null && Model.lstDetails.Rows.Count > 0)
                            {
                                int j = 1;
                                for (int i = 0; i <= Model.lstDetails.Rows.Count - 1; i++)
                                {
                                    <tr>
                                        <td>@j</td>
                                        <td class="font-weight-bold text-primary">@Model.lstDetails.Rows[i]["BookingNo"].ToString()</td>
                                        <td class="text-dark font-weight-bold">@Model.lstDetails.Rows[i]["CustomerName"].ToString()</td>
                                        <td>@Model.lstDetails.Rows[i]["AssociateName"].ToString()</td>
                                        <td><span class="badge badge-light border">@Model.lstDetails.Rows[i]["PlotInfo"].ToString()</span></td>
                                        <td><i class="fas fa-calendar-check mr-1 small"></i> @Model.lstDetails.Rows[i]["BookingDate"].ToString()</td>
                                        <td><i class="fas fa-calendar-times mr-1 small text-danger"></i> @Model.lstDetails.Rows[i]["CancelDate"].ToString()</td>
                                        <td class="font-weight-bold text-success">@Model.lstDetails.Rows[i]["RefundAmount"].ToString()</td>
                                        <td><small class="text-muted">@Model.lstDetails.Rows[i]["CancelRemark"].ToString()</small></td>
                                    </tr>
                                    j++;
                                }
                            }
                        </tbody>
                        <tfoot class="bg-light">
                            <tr>
                                <th colspan="5"></th>
                                <th colspan="2" class="text-right text-success">Total Booking Amt:</th>
                                <th colspan="2" class="h6 font-weight-bold text-primary">@ViewBag.BookingAmount</th>
                            </tr>
                            <tr>
                                <th colspan="5"></th>
                                <th colspan="2" class="text-right text-danger">Total Refund Amt:</th>
                                <th colspan="2" class="h6 font-weight-bold text-danger">@ViewBag.RefundAmount</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

<script src="../../Scripts/jquery-1.10.2.min.js"></script>
<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">

<script>
    $('#FromDate').datepicker({
        dateFormat: 'dd/mm/yy',
        changeYear: true,
        changeMonth: true
    });
    $('#Todate').datepicker({
        dateFormat: 'dd/mm/yy',
        changeYear: true,
        changeMonth: true
    });

    function onSiteChange() {
        var value = $('#SiteID').val();
        $.ajax({
            url: "/Masters/GetSiteDetails",
            Type: "Get",
            DataType: "JSON",
            data: { SiteID: value },
            success: function (data) {
                if (data.Result == "yes") {
                    $("#SectorID").empty();
                    $("#SectorID").append($('<option></option>').val(0).html('Select Sector'));
                    $.each(data.ddlSector, function (index, Sectorcount) {
                        $("#SectorID").append($('<option></option>').val(Sectorcount.Value).html(Sectorcount.Text));
                    });
                }
            }
        });
    }

    function onSectorChange() {
        var siteID = $('#SiteID').val();
        var sectorID = $('#SectorID').val();
        $.ajax({
            url: '/Masters/GetBlockList', type: 'post', dataType: 'json',
            data: { 'SiteID': siteID, 'sectorID': sectorID },
            success: function (data) {
                $("#BlockID").empty();
                $("#BlockID").append($('<option></option>').val(0).html('Select Block'));
                $.each(data.lstBlock, function (index, BlockCount) {
                    $("#BlockID").append($('<option></option>').val(BlockCount.Value).html(BlockCount.Text));
                });
            }
        });
    }
</script>
}
