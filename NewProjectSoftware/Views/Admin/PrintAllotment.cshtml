                {
                    <td style="border: 1px solid black;"><b> Via:    </b>@ViewBag.PaymentMode</td>
                    <td style="border: 1px solid black;"><b> Transaction No:    </b>@ViewBag.TransactionNo</td>
                    <td style="border: 1px solid black;"><b> Transaction Date:    </b>@ViewBag.TransactionDate</td>
                    <td style="border: 1px solid black;"><b> BankName:    </b>@ViewBag.BankName</td>
