@model RealEstateRegalSpace.Models.Reports

@{
    ViewBag.Title = "Bank Transactions";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@using (Html.BeginForm("GetBankTransactions", "Admin", FormMethod.Post, new { @id = "form1" }))
{
    <div class="container-fluid">
        <!-- Page-Title -->
        <div class="page-title-box">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h4 class="page-title">Bank Statement</h4>
                </div>
            </div>
        </div>

        <!-- Filter Card -->
        <div class="wizard-card animate-up mb-4">
            <div class="card-header-premium">
                <i class="fas fa-university mr-2"></i> Transaction Filters
            </div>
            <div class="p-4">
                <div class="row align-items-end">
                    <div class="col-md-3 mb-3">
                        <label class="small font-weight-bold text-muted">Select Bank</label>
                        @Html.DropDownListFor(m => m.Fk_BankId, new SelectList(ViewBag.ddlBank, "Value", "Text"), new { @class = "form-control", @style = "height: 48px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="small font-weight-bold text-muted"><i class="far fa-calendar-alt mr-1"></i> From Date</label>
                        @Html.TextBoxFor(m => m.FromDate, new { @class = "form-control", @readonly = "readonly", @Placeholder = "dd/mm/yyyy", @style = "height: 48px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="small font-weight-bold text-muted"><i class="far fa-calendar-alt mr-1"></i> To Date</label>
                        @Html.TextBoxFor(m => m.Todate, new { @class = "form-control", @readonly = "readonly", @Placeholder = "dd/mm/yyyy", @style = "height: 48px;" })
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="d-block">&nbsp;</label>
                        <button type="submit" id="btnSearchCustomer" name="btnSearchCustomer" value="Search" class="btn btn-primary btn-block shadow-sm font-weight-bold" style="height: 48px;">
                            <i class="fas fa-search mr-2"></i> View Statement
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Results Card -->
        <div class="wizard-card animate-up">
            <div class="card-header-premium secondary">
                <i class="fas fa-list-ul mr-2"></i> Transaction Details
            </div>
            <div class="p-0">
                <div class="table-responsive" style="overflow-x: auto;">
                    <table id="example23" class="table table-hover mb-0 custom-table text-nowrap">
                        <thead class="bg-light">
                            <tr>
                                <th class="text-center">Sr No</th>
                                <th>Date</th>
                                <th>Ref/Trans No</th>
                                <th>Particulars / Narration</th>
                                <th class="text-center">Mode</th>
                                <th>Bank</th>
                                <th class="text-right">Credit (In)</th>
                                <th class="text-right">Debit (Out)</th>
                                <th class="text-right font-weight-bold">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.lstDetails != null && Model.lstDetails.Rows.Count > 0)
                            {
                                for (int i = 0; i < Model.lstDetails.Rows.Count; i++)
                                {
                                    <tr>
                                        <td class="text-center text-muted">@(i + 1)</td>
                                        <td>@Model.lstDetails.Rows[i]["TransactionDate"].ToString()</td>
                                        <td class="small font-weight-bold">@Model.lstDetails.Rows[i]["TransactionNo"].ToString()</td>
                                        <td class="small">@Model.lstDetails.Rows[i]["Narration"].ToString()</td>
                                        <td class="text-center">
                                            <span class="badge badge-soft-info">@Model.lstDetails.Rows[i]["PaymentMode"].ToString()</span>
                                        </td>
                                        <td class="small">@Model.lstDetails.Rows[i]["BankName"].ToString()</td>
                                        <td class="text-right text-success font-weight-bold">
                                            @if (Model.lstDetails.Rows[i]["PaidAmount"].ToString() != "0")
                                            {
                                                <span>₹ @Model.lstDetails.Rows[i]["PaidAmount"].ToString()</span>
                                            }
                                        </td>
                                        <td class="text-right text-danger font-weight-bold">
                                            @if (Model.lstDetails.Rows[i]["Debit"].ToString() != "0")
                                            {
                                                <span>₹ @Model.lstDetails.Rows[i]["Debit"].ToString()</span>
                                            }
                                        </td>
                                        <td class="text-right font-weight-bold text-dark">₹ @Model.lstDetails.Rows[i]["Balance"].ToString()</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-5">
                                        <div class="text-muted">
                                            <i class="fas fa-university fa-3x mb-3 d-block opacity-50"></i>
                                            No bank transactions found for the selected period.
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        @if (Model != null && Model.lstDetails != null && Model.lstDetails.Rows.Count > 0)
                        {
                            <tfoot class="bg-light font-weight-bold">
                                <tr>
                                    <td colspan="6" class="text-right">Totals:</td>
                                    <td class="text-right text-success">₹ @ViewBag.totalCredit</td>
                                    <td class="text-right text-danger">₹ @ViewBag.totalDebit</td>
                                    <td class="text-right text-dark">₹ @ViewBag.totalBalance</td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@section Script {
    <script>
        $(document).ready(function () {
            $('#FromDate').datepicker({
                dateFormat: 'dd/mm/yy',
                changeYear: true,
                changeMonth: true
            });
            $('#Todate').datepicker({
                dateFormat: 'dd/mm/yy',
                changeYear: true,
                changeMonth: true
            });
        });
    </script>
}

