@model RealEstateRegalSpace.Models.InvestorModelNew

@{
    ViewBag.Title = "Investor List";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@section Header{
    <div class="row align-items-center">
        <div class="col-md-8">
            <div class="page-header-title">
                <h5 class="m-b-10">Masters</h5>

            </div>
        </div>
        <div class="col-md-4">
            <ul class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="javascript:void(0)"> <i class="fa fa-home"></i> </a>
                </li>

                <li class="breadcrumb-item">
                    <a href="javascript:void(0);">Investor List</a>
                </li>

            </ul>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <h5>Investor List</h5>

    </div>
    <div class="card-block">

        <!-- Page-Title -->

        <div class="form-group row">
            <div class="col-lg-12">
                <div class="row gutters table-responsive">
                    <table id="example23" class="table table-bordered">

                        <thead>
                            <tr>
                                <th>S No.</th>
                                <th>Investor Id</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Mobile</th>
                                <th>Address</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                if (Model.InvestorList != null)
                                {
                                    if (Model.InvestorList.Rows.Count > 0)
                                    {
                                        int j = 1;
                                        for (int i = 0; i <= Model.InvestorList.Rows.Count - 1; i++)
                                        {
                                            <tr>
                                                <td>@j</td>
                                                <td>@Model.InvestorList.Rows[i]["InvestorCode"].ToString()</td>

                                                <td>@Model.InvestorList.Rows[i]["FirstName"].ToString() @Model.InvestorList.Rows[i]["LastName"].ToString()</td>
                                                <td>@Model.InvestorList.Rows[i]["EmailAddress"].ToString()</td>
                                                <td>@Model.InvestorList.Rows[i]["MobileNo"].ToString()</td>
                                                <td>@Model.InvestorList.Rows[i]["Address"].ToString()</td>
                                                <td>
                                                    <a href="/Admin/AddInvestor?Id=@Model.InvestorList.Rows[i]["Pk_InvestorId"].ToString()" class="btn btn-info btn-sm">Edit</a>
                                                    <a class="btn btn-primary btn-sm" href="/Admin/ReceiveInvestment?id=@Model.InvestorList.Rows[i]["Pk_InvestorId"].ToString()">Receive</a>
                                                    <a class="btn btn-warning btn-sm" href="/Admin/PayInvestment?id=@Model.InvestorList.Rows[i]["Pk_InvestorId"].ToString()">Pay</a>
                                                    @*  <a href="/Admin/DeleteInvestor?Id=@Model.InvestorList.Rows[i]["Pk_InvestorId"].ToString()" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you wish to delete this Bank?');">Delete</a>*@
                                                </td>

                                            </tr>
                                            j++;
                                        }

                                    }
                                }
                            }

                        </tbody>
                        <tfoot>

                        </tfoot>
                    </table>
                </div>

            </div>
        </div>
        </div>
    </div>
        <script>
            function fn_showPWD(id, pwd) {
                if ($('#' + id).html() != '******') {
                    $('#' + id).html('******');
                }
                else {
                    $('#' + id).html(pwd);
                }
            }
        </script>
        <script src="../../assets/js/jquery.min.js"></script>
        <link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">
        <script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>




        <script>
            $(document).ready(function () {
                $("#divload").css({ 'display': 'none' });
            });
        </script>
