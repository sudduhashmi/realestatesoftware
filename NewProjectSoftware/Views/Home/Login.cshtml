@model RealEstateRegalSpace.Models.Login

@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">
<head>
    <title>Shashikala Infratech</title>


    <!--[if lt IE 10]>
          <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
          <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
          <![endif]-->

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content="" />
    <meta name="keywords" content="" />
    <meta name="author" content="" />

    <link rel="icon" href="../files/assets/images/logo.png" type="image/x-icon">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="../files/bower_components/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="../files/assets/pages/waves/css/waves.min.css" type="text/css" media="all">
    <link rel="stylesheet" type="text/css" href="../files/assets/icon/themify-icons/themify-icons.css">
    <link rel="stylesheet" type="text/css" href="../files/assets/icon/icofont/css/icofont.css">
    <link rel="stylesheet" type="text/css" href="../files/assets/icon/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" type="text/css" href="../files/assets/css/style.css">
    <style>
        :root {
            --primary-navy: #001a2c;
            --secondary-navy: #003d66;
            --accent-gold: #ff9800;
            --glass-bg: rgba(255, 255, 255, 0.9);
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f4f7f6;
            overflow-x: hidden;
            margin: 0;
            padding: 0;
        }

        .login-block {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f4f7f6;
        }

        /* Entrance Animations */
        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .animate-up { animation: fadeInUp 0.8s ease-out forwards; }
        .animate-fade { animation: fadeIn 1.2s ease-out forwards; }

        /* Floating animation */
        @@keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-15px) rotate(2deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }

        /* Card Styling */
        .login-card {
            background: #ffffff;
            border-radius: 30px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
            padding: 50px;
            width: 100%;
            max-width: 440px;
            border: 1px solid rgba(255, 255, 255, 0.8);
            transition: var(--transition);
        }

        .login-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 35px 60px -15px rgba(0, 0, 0, 0.15);
        }

        /* Input styling */
        .form-group {
            margin-bottom: 25px;
        }

        .form-control {
            border-radius: 12px;
            height: 52px;
            font-size: 0.95rem;
            border: 1.5px solid #e2e8f0;
            padding: 12px 20px;
            transition: var(--transition);
            background: #f8fafc;
        }

        .form-control:focus {
            border-color: var(--secondary-navy);
            box-shadow: 0 0 0 4px rgba(0, 61, 102, 0.1);
            background: #fff;
        }

        .input-group-text {
            background: #f8fafc;
            border: 1.5px solid #e2e8f0;
            border-left: none;
            border-radius: 0 12px 12px 0;
            height: 52px;
            color: #64748b;
            cursor: pointer;
            transition: var(--transition);
            padding: 0 15px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #passwordField {
            border-right: none;
        }

        /* Button Styling */
        .btn-premium {
            background: linear-gradient(135deg, var(--primary-navy) 0%, var(--secondary-navy) 100%);
            color: white;
            height: 52px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1rem;
            letter-spacing: 0.5px;
            border: none !important;
            box-shadow: 0 10px 25px rgba(0, 26, 44, 0.25);
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            margin-top: 10px;
        }

        .btn-premium:hover {
            transform: scale(1.02);
            box-shadow: 0 15px 30px rgba(0, 26, 44, 0.35);
            color: #fff;
        }

        /* Right Side Polish */
        .welcome-section {
            background: linear-gradient(135deg, rgba(0, 26, 44, 0.85) 0%, rgba(0, 61, 102, 0.85) 100%), url('@Url.Content("~/files/assets/images/login_bg.png")');
            background-size: cover;
            background-position: center;
            position: relative;
            overflow: hidden;
        }

        .logo-container {
            width: 150px;
            height: 150px;
            background: #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            animation: float 4s ease-in-out infinite;
            margin: 0 auto 35px;
        }

        .welcome-title {
            font-size: 3.2rem;
            font-weight: 800;
            letter-spacing: -1.2px;
        }

        .welcome-text {
            line-height: 1.8;
            opacity: 0.95;
            max-width: 550px;
            margin: 0 auto;
        }

        /* Responsive Improvements */
        @@media (max-width: 991px) {
            .welcome-section {
                display: none !important;
            }
            .login-card {
                margin: 20px;
                padding: 35px;
            }
            .col-md-6 {
                flex: 0 0 100%;
                max-width: 100%;
            }
        }
    </style>
    </style>
</head>
<body themebg-pattern="theme1">

    <section class="login-block">

        <div class="container-fluid p-0">
            @using (Html.BeginForm("Login", "Home", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
            {
                <div class="row no-gutters" style="min-height:100vh;">

                    <!-- LEFT SIDE (LOGIN FORM) -->
                    <div class="col-md-6 d-flex align-items-center justify-content-center">

                        <div class="login-card animate-up">
                            <div class="text-center mb-5">
                                <h2 class="font-weight-bold" style="color: var(--primary-navy); font-size: 2.2rem; letter-spacing: -1px;">Sign In</h2>
                                <p class="text-muted" >Enter your credentials to access your account</p>
                            </div>

                            <div class="form-group">
                                <label class="font-weight-bold text-dark mb-2" style="letter-spacing: 0.5px; font-size: 0.9rem;">LOGIN ID</label>
                                @Html.TextBoxFor(m => m.loginId, new { @class = "form-control", @placeholder = "Enter your login id" })
                            </div>

                            <div class="form-group">
                                <label class="font-weight-bold text-dark mb-2" style="letter-spacing: 0.5px; font-size: 0.9rem;">PASSWORD</label>
                                <div class="input-group">
                                    @Html.PasswordFor(m => m.password, new { @class = "form-control", @placeholder = "Enter your password", @id = "passwordField" })
                                    <div class="input-group-append">
                                        <span class="input-group-text" onclick="togglePassword()">
                                            <i class="fa fa-eye" id="toggleIcon" style="font-size: 1rem;"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mb-4">
                                <a href="#" class="font-weight-bold text-primary" data-toggle="modal" data-target="#myModal" style="font-size: 0.9rem;">Forgot Password?</a>
                            </div>

                            <button type="submit" class="btn btn-premium" onclick="return fvalidate();">
                                Login to Dashboard
                            </button>

                            @if (TempData["Login"] != null)
                            {
                                <div class="alert alert-danger mt-4 text-center py-2" style="border-radius: 12px; font-size: 0.85rem;">
                                    <i class="fa fa-exclamation-circle mr-2"></i> @TempData["Login"]
                                </div>
                            }

                        </div>

                    </div>


                    <!-- RIGHT SIDE (ANIMATION + IMAGE) -->
                    <div class="col-md-6 d-none d-md-flex align-items-center justify-content-center text-white">
                        
                        <div class="welcome-section w-100 h-100 d-flex align-items-center justify-content-center animate-fade">
                            <div class="text-center px-5">
                                <div class="logo-container">
                                    <img src="@Url.Content("~/files/assets/images/logo.png")" style="max-width: 70%; max-height: 70%; object-fit: contain;">
                                </div>
                                
                                <h3 class="welcome-title">Welcome Back</h3>
                                
                                <p class="welcome-text">
                                    Experience the pinnacle of real estate management with <strong>Shashikala Infratech</strong>. 
                                    We help you build a better tomorrow through excellence and trust.
                                </p>

                                <div class="mt-5 pt-4" style="border-top: 1px solid rgba(255,255,255,0.2);">
                                    <div class="d-flex justify-content-center">
                                        <div class="px-4 border-right border-white-50">
                                            <h4 class="font-weight-bold mb-0">100%</h4>
                                            <p class="small mb-0 opacity-75">Secure</p>
                                        </div>
                                        <div class="px-4">
                                            <h4 class="font-weight-bold mb-0">24/7</h4>
                                            <p class="small mb-0 opacity-75">Support</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>


                <!-- MODAL SAME (UNCHANGED) -->
                <div class="modal fade" id="myModal" role="dialog">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal">&times;</button>
                            </div>
                            <div class="modal-body">
                                <input type="text" class="form-control" placeholder="LoginId" id="login" />
                                <br />
                                <a href="#" class="btn btn-success" onclick="return getpassword();">Get Password</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </section>


    <script type="text/javascript" src="../files/bower_components/jquery/js/jquery.min.js"></script>
    <script type="text/javascript" src="../files/bower_components/jquery-ui/js/jquery-ui.min.js"></script>
    <script type="text/javascript" src="../files/bower_components/popper.js/js/popper.min.js"></script>
    <script type="text/javascript" src="../files/bower_components/bootstrap/js/bootstrap.min.js"></script>

    <script src="../files/assets/pages/waves/js/waves.min.js"></script>

    <script type="text/javascript" src="../files/bower_components/jquery-slimscroll/js/jquery.slimscroll.js"></script>

    <script type="text/javascript" src="../files/bower_components/modernizr/js/modernizr.js"></script>
    <script type="text/javascript" src="../files/bower_components/modernizr/js/css-scrollbars.js"></script>

    <script type="text/javascript" src="../files/bower_components/i18next/js/i18next.min.js"></script>
    <script type="text/javascript" src="../files/bower_components/i18next-xhr-backend/js/i18nextXHRBackend.min.js"></script>
    <script type="text/javascript" src="../files/bower_components/i18next-browser-languagedetector/js/i18nextBrowserLanguageDetector.min.js"></script>
    <script type="text/javascript" src="../files/bower_components/jquery-i18next/js/jquery-i18next.min.js"></script>
    <script type="text/javascript" src="../files/assets/js/common-pages.js"></script>
</body>
</html>




<script src="../../assets/js/jquery.min.js"></script>
<script src="../../AdminPanelCss/js/bootstrap.min.js"></script>
<script>
    function fvalidate() {
        $(".errortext").removeClass("errortext");
        if ($('#loginId').val() == '') {
            $("#loginId").addClass('errortext');
            $('#loginId').focus();
            return false;
        }
        if ($('#password').val() == '') {
            $("#password").addClass('errortext');
            $('#password').focus();
            return false;
        }


    }
    function getpassword() {
        if ($('#login').val() == '') {
            $("#login").addClass('errortext');
            $('#login').focus();
            return false;
        }
        $.ajax({
            url: "/Home/GetPassword",
            Type: "Get",
            DataType: "JSON",
            data: { LoginId: $("#login").val() },
            success: function (data) {
                if (data.Result == "1") {
                    alert("Password Send on your registered mobile No.");
                }
                else {
                    alert("Invalid LoginId");
                }


            }

        });
    }
</script>
<script>
    function togglePassword() {
        var password = document.getElementById("passwordField");
        var icon = document.getElementById("toggleIcon");

        if (password.type === "password") {
            password.type = "text";
            icon.classList.remove("fa-eye");
            icon.classList.add("fa-eye-slash");
        } else {
            password.type = "password";
            icon.classList.remove("fa-eye-slash");
            icon.classList.add("fa-eye");
        }
    }
</script>
