@model RealEstateRegalSpace.Models.Master

@{
    ViewBag.Title = "PlotSizeList";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}



@using (Html.BeginForm("PlotSizeList", "Masters", FormMethod.Post, new { @id = "form1" }))
{
    <div class="wrapper">
        <div class="container-fluid">

            <div class="card-block">

                <!-- Page-Title -->
                <div class="page-title-box">
                    <div class="row align-items-center">
                        <div class="col-sm-6">
                            <h4 class="page-title">Plot Size List</h4>
                        </div>
                     
                    </div>
                    <!-- end row -->
                </div>
                <div class="form-group row">
                    <div class="col-lg-12">
                        <div class="row">
                            <div class="dt-responsive table-responsive">
                                <table class="table table-bordered table-striped table-hover js-basic-example dataTable" id="example23">
                                    <thead>
                                        <tr>
                                            <th>S No.</th>
                                            <th>Width (Ft/Mt)</th>
                                            <th>Width Inch</th>
                                            <th>Height (Ft/Mt)</th>
                                            <th>Height Inch</th>
                                            <th>Plot Area</th>
                                            <th>Unit</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null)
                                        {
                                            if (Model.lstSite != null)
                                            {
                                                int i = 1;
                                                foreach (var Item in Model.lstSite)
                                                {
                                                    <tr class="text-left">
                                                        <td>@i</td>
                                                        <td>@Item.WidthFeet</td>
                                                        <td>@(Item.UnitID == "2" ? "-" : Item.WidthInch)</td>
                                                        <td>@Item.HeightFeet</td>
                                                        <td>@(Item.UnitID == "2" ? "-" : Item.HeightInch)</td>
                                                        <td>@Item.PlotArea</td>
                                                        <td>
                                                            @{
                                                                string displayUnit = "Sq/Ft"; // Default
                                                                string areaText = (Item.PlotArea ?? "").ToLower();
                                                                
                                                                if (Item.UnitID == "2" || areaText.Contains("mt") || areaText.Contains("meter"))
                                                                {
                                                                    displayUnit = "Sq/Mt";
                                                                }
                                                                else if (Item.UnitID == "1" || areaText.Contains("ft") || areaText.Contains("feet"))
                                                                {
                                                                    displayUnit = "Sq/Ft";
                                                                }
                                                            }
                                                            <span class="badge @(displayUnit == "Sq/Mt" ? "badge-success" : "badge-primary")" style="font-size: 11px; padding: 5px 10px;">
                                                                @displayUnit
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <a href="/Masters/PlotSizeMaster?plotSizeID=@Item.EncryptKey" class="btn btn-info btn-sm">
                                                                <i class="fas fa-edit"></i> Edit
                                                            </a>
                                                            <a href="/Masters/DeletePlotSize?id=@Item.PlotSizeID" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you wish to delete this Plot Size?');">
                                                                <i class="fas fa-trash"></i> Delete
                                                            </a>
                                                        </td>

                                                    </tr>
                                                    i++;
                                                }

                                            }
                                        }

                                    </tbody>

                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

