@model RealEstateRegalSpace.Models.Master
@{
    ViewBag.Title = "Plot Master";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

@using (Html.BeginForm("PlotMaster", "Masters", FormMethod.Post, new { @id = "form1", enctype = "multipart/form-data" }))
{
    <div class="container-fluid">
        <!-- Stepper Wizard -->
        <div class="stepper-wrapper animate-up">
            <div class="step-item completed">
                <div class="step-counter"><i class="fas fa-check"></i></div>
                <div class="step-name">Project</div>
            </div>
            <div class="step-item completed">
                <div class="step-counter"><i class="fas fa-check"></i></div>
                <div class="step-name">Sector</div>
            </div>
            <div class="step-item completed">
                <div class="step-counter"><i class="fas fa-check"></i></div>
                <div class="step-name">Block</div>
            </div>
            <div class="step-item completed">
                <div class="step-counter"><i class="fas fa-check"></i></div>
                <div class="step-name">Size</div>
            </div>
            <div class="step-item completed">
                <div class="step-counter"><i class="fas fa-check"></i></div>
                <div class="step-name">PLC</div>
            </div>
            <div class="step-item active">
                <div class="step-counter">6</div>
                <div class="step-name">Plot</div>
            </div>
            <div class="step-item">
                <div class="step-counter">7</div>
                <div class="step-name">Bank</div>
            </div>
            <div class="step-item">
                <div class="step-counter">8</div>
                <div class="step-name">Account</div>
            </div>
        </div>

        <div class="wizard-card wizard-card-c animate-up">
            <div class="page-title-box">
                <div class="row align-items-center">
                    <div class="col-sm-6">
                        <h4 class="page-title">Create Plot Master</h4>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-sm-12">
                    <div class="custom-control custom-radio custom-control-inline">
                        <input type="radio" id="rdbregular" name="plottype" class="custom-control-input" @(ViewBag.RegularPlot == "1" ? "checked" : "") onclick="return getdetails('RegularPlot')" />
                        <label class="custom-control-label" for="rdbregular">Regular Plot</label>
                    </div>
                    <div class="custom-control custom-radio custom-control-inline">
                        <input type="radio" id="rdbnonregular" name="plottype" class="custom-control-input" @(ViewBag.RegularPlot != "1" ? "checked" : "") onclick="return getdetails('NonRegularPlot')" />
                        <label class="custom-control-label" for="rdbnonregular">Non-Regular Plot</label>
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-sm-3">
                    <label class="font-weight-bold">Project Name <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.SiteID, new SelectList(ViewBag.ddlSite, "Value", "Text"), new { @class = "form-control", @onchange = "return onSiteChange();" })
                </div>
                <div class="col-sm-3">
                    <label class="font-weight-bold">Sector Name <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.SectorID, new SelectList(ViewBag.ddlSector, "Value", "Text"), new { @class = "form-control", @onchange = "return onSectorChange();" })
                </div>
                <div class="col-sm-3">
                    <label class="font-weight-bold">Block Name <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.BlockID, new SelectList(ViewBag.ddlBlock, "Value", "Text"), new { @class = "form-control" })
                </div>
                <div class="col-sm-3">
                    <label class="font-weight-bold">Plot Rate <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.PlotRate, new { @class = "form-control", @Placeholder = "0.00", @onkeypress = "return isNumberOrDecimal(event);", @onchange = "return calculatePlotAmount();" })
                </div>
            </div>

            <div class="row mt-3">
                <div id="plotsize" class="col-sm-3">
                    <label class="font-weight-bold">Plot Size <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m => m.PlotSizeID, new SelectList(ViewBag.ddlPlotSize, "Value", "Text"), new { @class = "form-control", @onchange = "return calculatePlotAmount();" })
                </div>
                <div id="plotarea" class="col-sm-3" style="display:none">
                    <label class="font-weight-bold">Plot Area <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.PlotArea, new { @class = "form-control", @Placeholder = "0.00", @onkeypress = "return isNumberOrDecimal(event);", @onchange = "return calculatePlotAmount();" })
                </div>
                <div class="col-sm-3">
                    <label class="font-weight-bold">Booking Amount <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.BookingPercent, new { @class = "form-control", @Placeholder = "0.00", @onkeypress = "return isNumberOrDecimal(event);" })
                </div>
                <div class="col-sm-3">
                    <label class="font-weight-bold">Plot Amount</label>
                    @Html.TextBoxFor(m => m.PlotAmount, new { @class = "form-control", @Readonly = "readonly", @Placeholder = "0.00" })
                </div>
                <div class="col-sm-3">
                    <label class="font-weight-bold">Allotment (%) <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.AllottmentPercent, new { @class = "form-control", @Placeholder = "0.00", @onkeypress = "return isNumberOrDecimal(event);" })
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-sm-3">
                    <label class="font-weight-bold">Prefix</label>
                    @Html.TextBoxFor(m => m.PlotPrefix, new { @class = "form-control", @Placeholder = "e.g. P-" })
                </div>
                <div class="col-sm-3">
                    <label class="font-weight-bold">From Plot <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.FromPlot, new { @class = "form-control", @Placeholder = "1", @onkeypress = "return isNumberOrDecimal(event);" })
                </div>
                <div class="col-sm-3">
                    <label class="font-weight-bold">To Plot <span class="text-danger">*</span></label>
                    @Html.TextBoxFor(m => m.ToPlot, new { @class = "form-control", @Placeholder = "10", @onkeypress = "return isNumberOrDecimal(event);" })
                </div>
                <div class="col-sm-3">
                    <label class="font-weight-bold">Postfix</label>
                    @Html.TextBoxFor(m => m.PlotPostfix, new { @class = "form-control", @Placeholder = "e.g. -A" })
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12">
                    <label class="font-weight-bold">Select Applicable PLC</label>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover bg-light">
                            <thead class="thead-light">
                                <tr>
                                    <th width="50">Select</th>
                                    <th>PLC Name</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.dtPLC != null)
                                {
                                    int j = 1;
                                    for (int i = 0; i < Model.dtPLC.Rows.Count; i++)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                <input type="checkbox" id="chk_@j" name="chk_@j" @(Model.dtPLC.Rows[i]["Item"].ToString() != "" ? "checked" : "") />
                                                <input type="hidden" id="plcid_@j" name="plcid_@j" value="@Model.dtPLC.Rows[i]["PK_PLCID"].ToString()" />
                                            </td>
                                            <td>@Model.dtPLC.Rows[i]["PLCName"].ToString()</td>
                                        </tr>
                                        j++;
                                    }
                                    <input type="hidden" id="hdRows" name="hdRows" value="@j" />
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="wizard-footer">
                <div class="left-actions">
                    <a class="btn btn-outline-secondary mr-2" href="/Masters/PLCMaster">
                        <i class="fas fa-arrow-left mr-2"></i> Previous
                    </a>
                    <a class="btn btn-outline-primary" href="/Masters/PlotList">
                        <i class="fas fa-list mr-2"></i> View Plot List
                    </a>
                </div>
                <div class="right-actions">
                    @if (Model.PlotID == null)
                    {
                        <input class="btn btn-primary btn-lg" type="submit" onclick="return validateform();" value="Save & Continue" id="btnSave" name="btnSave" style="padding-left: 30px; padding-right: 30px;" />
                    }
                    else
                    {
                        @Html.HiddenFor(m => m.PlotID)
                        <input class="btn btn-success btn-lg" type="submit" onclick="return validateform();" value="Update Plot" id="btnUpdate" name="btnUpdate" />
                    }
                </div>
            </div>
            <div class="text-center mt-3">
                <p class="text-danger font-weight-bold">@TempData["Plot"]</p>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.PlotStatus)
}

<script src="//code.jquery.com/ui/1.11.4/jquery-ui.js"></script>
<link rel="stylesheet" type="text/css" href="https://code.jquery.com/ui/1.12.0/themes/smoothness/jquery-ui.css">
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<script>

    $(document).ready(function () {

        if ($("#rdbregular").prop("checked", true)) {
            $('#plotsize').css({ 'display': '' });
            $('#plotarea').css({ 'display': 'none' });
            $('#PlotStatus').val('RegularPlot');
        }
        else {
            $('#plotsize').css({ 'display': 'none' });
            $('#plotarea').css({ 'display': '' });
            $('#PlotStatus').val('NonRegularPlot');
        }

    });
    function calculatePlotAmount() {
        if ($('#PlotStatus').val() == "RegularPlot") {
            var ddlSize = document.getElementById("PlotSizeID");
            var selectedPlotSize = ddlSize.options[ddlSize.selectedIndex].text;

            var plotSize = selectedPlotSize.split(" ");
            var plotRate = $("#PlotRate").val();

            var plotAmount = Number(plotSize[0]) * Number(plotRate);
            //alert(plotArea);
            document.getElementById("PlotAmount").value = plotAmount;
        }
        else {
            var plotAmount = Number($('#PlotArea').val()) * Number($("#PlotRate").val());
            document.getElementById("PlotAmount").value = plotAmount;
        }
    }
    function getdetails(plottype) {
        if (plottype == "RegularPlot") {
            $('#plotsize').css({ 'display': '' });
            $('#plotarea').css({ 'display': 'none' });
            $('#PlotStatus').val('RegularPlot');
        }
        else {
            $('#plotsize').css({ 'display': 'none' });
            $('#plotarea').css({ 'display': '' });
            $('#PlotStatus').val('NonRegularPlot');
        }
    }
    function onSiteChange() {
        $("#divload").css({ 'display': '' });
        var value = $('#SiteID').val();
        var values = $('#SectorID').val();
        var tr = [];
        $.ajax({
            url: "/Masters/GetSiteDetails",
            Type: "Get",
            DataType: "JSON",
            data: { SiteID: value },
            success: function (data) {
                $("#divload").css({ 'display': 'none' });
                var j = 1;
                //alert(data.Result);
                if (data.Result == "yes") {
                    //alert(data.Rate);

                    $("#SectorID").html(""); // clear before appending new list
                    $("#SectorID").empty();
                    $("#BlockID").empty();
                    $("#SectorID").append(
                        $('<option></option>').val(0).html('Select Sector'));
                    $.each(data.ddlSector, function (index, Sectorcount) {
                        $("#SectorID").append(
                            $('<option></option>').val(Sectorcount.Value).html(Sectorcount.Text));

                    });



                }
                else {
                    $('#Rate').val('');
                }
            }

        });

    }

    function onSectorChange() {
        debugger;
        $("#divload").css({ 'display': '' });
        var siteID = $('#SiteID').val();
        var sectorID = $('#SectorID').val();
        $.ajax({
            url: '/Masters/GetBlockList', type: 'post', dataType: 'json',
            data: { 'SiteID': siteID, 'sectorID': sectorID },
            success: function (data) {
                $("#divload").css({ 'display': 'none' });
                $("#BlockID").html(""); // clear before appending new list
                $("#BlockID").empty();
                $("#BlockID").append(
                    $('<option></option>').val(0).html('Select Block'));
                $.each(data.lstBlock, function (index, BlockCount) {
                    $("#BlockID").append(
                        $('<option></option>').val(BlockCount.Value).html(BlockCount.Text));
                });

            }

        });
    }

    function validateform() {
        $(".errortext").removeClass("errortext");
        if ($('#SiteID').val() == '0') {
            $("#SiteID").addClass('errortext');
            $('#SiteID').focus();
            return false;
        }
        if ($('#SectorID').val() == '0') {
            $("#SectorID").addClass('errortext');
            $('#SectorID').focus();
            return false;
        }

        if ($('#BlockID').val() == '0') {
            $("#BlockID").addClass('errortext');
            $('#BlockID').focus();
            return false;
        }

        if ($('#PlotRate').val() == '') {
            $("#PlotRate").addClass('errortext');
            $('#PlotRate').focus();
            return false;
        }
        if ($('#PlotStatus').val() == "RegularPlot") {
            if ($('#PlotSizeID').val() == '0') {
                $("#PlotSizeID").addClass('errortext');
                $('#PlotSizeID').focus();
                return false;
            }
        }
        else {
            if ($('#PlotArea').val() == '') {
                $("#PlotArea").addClass('errortext');
                $('#PlotArea').focus();
                return false;
            }
        }
        if ($('#BookingPercent').val() == '') {
            $("#BookingPercent").addClass('errortext');
            $('#BookingPercent').focus();
            return false;
        }
        if ($('#AllottmentPercent').val() == '') {
            $("#AllottmentPercent").addClass('errortext');
            $('#AllottmentPercent').focus();
            return false;
        }

        //if ($('#PlotPrefix').val() == '') {
        //    $("#PlotPrefix").addClass('errortext');
        //    $('#PlotPrefix').focus();
        //    return false;
        //}
        if ($('#FromPlot').val() == '') {
            $("#FromPlot").addClass('errortext');
            $('#FromPlot').focus();
            return false;
        }
        if ($('#ToPlot').val() == '') {
            $("#ToPlot").addClass('errortext');
            $('#ToPlot').focus();
            return false;
        }

        var allottmentPercentage = $('#AllottmentPercent').val();
        if ((Number)(allottmentPercentage) > 100) {
            $('#AllottmentPercent').val('');
            $("#AllottmentPercent").addClass('errortext');
            $('#AllottmentPercent').focus();
            return false;
        }

        var fromPlot = $('#FromPlot').val();
        var toPlot = $('#ToPlot').val();
        if ((Number)(toPlot) < (Number)(fromPlot)) {
            $("#FromPlot").addClass('errortext');
            $("#ToPlot").addClass('errortext');
            $('#FromPlot').val('');
            $('#ToPlot').val('');
            return false;
        }

        return true;
    }

    function isNumberOrDecimal(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode != 46 && charCode > 31
            && (charCode < 48 || charCode > 57))
            return false;

        return true;
    }

    function onlyAlphabets(e, t) {
        try {
            if (window.event) {
                var charCode = window.event.keyCode;
            }
            else if (e) {
                var charCode = e.which;
            }
            else { return true; }
            if ((charCode > 64 && charCode < 91) || (charCode > 96 && charCode < 123))
                return true;
            else
                return false;
        }
        catch (err) {
            alert(err.Description);
        }
    }

</script>


<style>
    .errortext {
        border: 1px solid red !important;
        background-color: #fff0f0 !important;
    }
</style>
