@model RealEstateRegalSpace.Models.Master

@{
    ViewBag.Title = "SiteList";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}


<div class="wrapper">
    <div class="container-fluid">

        <div class="card-block">

            <div class="page-title-box">
                <div class="row align-items-center">
                    <div class="col-sm-6">
                        <h4 class="page-title">Site List</h4>
                    </div>
                   
                </div>
                <!-- end row -->
            </div>
            <div class="form-group row">
                <div class="col-lg-12">
                    <div class="row">
                        <div class="dt-responsive table-responsive">
                            <table class="table table-bordered table-striped table-hover js-basic-example dataTable" id="example23">
                                <thead>
                                    <tr>
                                        <th>S No.</th>
                                        <th>SiteName</th>
                                        <th>Location</th>

                                        <th>Action</th>
                                    </tr>

                                </thead>
                                <tbody>
                                    @if (Model != null)
                                    {
                                        if (Model.lstSite != null)
                                        {
                                            int i = 1;
                                            foreach (var Item in Model.lstSite)
                                            {
                                                <tr class="text-left">
                                                    <td>@i</td>
                                                    <td>@Item.SiteName</td>
                                                    <td>@Item.Location</td>

                                                    <td>
                                                        <a href="/Masters/SiteMaster?SiteID=@Item.EncryptKey" class="btn btn-info btn-sm">Edit</a>
                                                        <a href="/Masters/DeleteSite?id=@Item.SiteID" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you wish to delete this Site?');">Delete</a>
                                                    </td>

                                                </tr>

                                                i++;
                                            }
                                        }
                                    }

                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>S No.</th>
                                        <th>SiteName</th>
                                        <th>Location</th>

                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
