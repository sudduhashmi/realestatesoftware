@model RealEstateRegalSpace.Models.Reports

@{
    ViewBag.Title = "AssociateDownlineDetail";
    Layout = "~/Views/Shared/Layout.cshtml";
}

@section Header{

    <div class="row align-items-center">
        <div class="col-md-8">
            <div class="page-header-title">
                <h5 class="m-b-10">Associate </h5>

            </div>
        </div>
        <div class="col-md-4">
            <ul class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="index.html"> <i class="fa fa-home"></i> </a>
                </li>
                <li class="breadcrumb-item">
                    <a href="#!">Downline</a>
                </li>
            </ul>
        </div>
    </div>
}



<div class="card">
    <div class="card-header">
        <h5>Downline</h5>

    </div>
    <div class="card-block">

        <!-- Page-Title -->

        <div class="form-group row">
            <div class="col-lg-12">
                <div class="row">

                    <div class="dt-responsive table-responsive">
                        <table id="basic-btn" class="table table-striped table-bordered nowrap">
                            <thead>
                                <tr>
                                    <th>S No.</th>
                                    <th>LoginId</th>
                                    <th>Name</th>
                                    <th>Rank Name</th>
                                    <th>Percentage</th>

                                    <th>Mobile Number</th>

                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null)
                                {
                                    if (Model.lstDetails != null)
                                    {
                                        if (Model.lstDetails.Rows.Count > 0)
                                        {
                                            int j = 1;
                                            for (int i = 0; i <= Model.lstDetails.Rows.Count - 1; i++)
                                            {
                                                <tr class="text-left">
                                                    <td>@j</td>
                                                    <td>@Model.lstDetails.Rows[i]["AssociateId"].ToString()   </td>
                                                    <td>@Model.lstDetails.Rows[i]["AssociateName"].ToString()   </td>
                                                    <td>@Model.lstDetails.Rows[i]["DesignationName"].ToString()   </td>
                                                    <td>@Model.lstDetails.Rows[i]["Percentage"].ToString()   </td>
                                                    <td>@Model.lstDetails.Rows[i]["Mobile"].ToString()   </td>


                                                </tr>
                                                j++;
                                            }
                                        }

                                    }
                                }

                            </tbody>
                            <tfoot>
                                <tr>
                                    <th>S No.</th>
                                    <th>Affiliate ID</th>
                                    <th>Affiliate Name</th>
                                    <th>Rank Name</th>
                                    <th>Percentage</th>

                                    <th>Mobile Number</th>


                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


