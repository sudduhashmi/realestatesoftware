@model RealEstateRegalSpace.Models.EmployeeRegistrations

@{
    ViewBag.Title = "EmployeeDetails";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}
@using (Html.BeginForm("EmployeeDetails", "EmployeeRegistration", FormMethod.Post, new { @id = "form1" }))
{
    <div class="container-fluid">
        <!-- Page-Title -->
        <div class="page-title-box">
            <div class="row align-items-center">
                <div class="col-sm-6">
                    <h4 class="page-title">User Management</h4>
                </div>
                <div class="col-sm-6 text-right">
                    <a href="/Permission/EmployeeRegistration" class="btn btn-primary shadow-sm">
                        <i class="fas fa-plus mr-1"></i> Add New User
                    </a>
                </div>
            </div>
        </div>

        <div class="wizard-card animate-up">
            <div class="p-4">
                <div class="table-responsive">
                    <table id="example23" class="table table-hover custom-table" cellspacing="0" width="100%">
                        <thead class="bg-light">
                            <tr>
                                <th>#</th>
                                <th>Employee Details</th>
                                <th>Login Credentials</th>
                                <th>Qualification</th>
                                <th>Contact Info</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.lstemp != null)
                            {
                                int i = 1;
                                foreach (var item in Model.lstemp)
                                {
                                    <tr>
                                        <td><span class="badge badge-light">@i</span></td>
                                        <td>
                                            <div class="font-weight-bold text-dark">@item.Name</div>
                                            <small class="text-muted">ID: @item.LoginId</small>
                                        </td>
                                        <td>
                                            <div><i class="fas fa-user-lock mr-1 small"></i> @item.LoginId</div>
                                            <div class="text-muted small"><i class="fas fa-key mr-1 small"></i> @RealEstateRegalSpace.Crypto.Decrypt(item.Password)</div>
                                        </td>
                                        <td>@item.EducationQualififcation</td>
                                        <td>
                                            <div><i class="fas fa-phone-alt mr-1 small"></i> @item.Mobile</div>
                                            <div class="text-info small"><i class="fas fa-envelope mr-1 small"></i> @item.Email</div>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group">
                                                <a href="/Permission/EmployeeRegistration?PK_UserID=@item.PK_UserID" class="btn btn-sm btn-outline-success mr-2 rounded-circle" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="/Permission/DeleteEmployee?PK_UserID=@item.PK_UserID" class="btn btn-sm btn-outline-danger rounded-circle" onclick="return confirm('Are you sure you want to delete this user?')" title="Delete">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

}

