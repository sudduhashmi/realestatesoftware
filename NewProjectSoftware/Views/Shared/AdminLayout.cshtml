    <script>
        $(document).ready(function() {
            // Set active menu based on current URL
            var currentUrl = window.location.pathname;
            $('#side-menu a').each(function() {
                var href = $(this).attr('href');
                if (href === currentUrl) {
                    $(this).parent('li').addClass('active');
                    // If it's a submenu item, open the parent
                    var $parentSubmenu = $(this).closest('.submenu');
                    if ($parentSubmenu.length > 0) {
                        $parentSubmenu.parent('.has-submenu').addClass('open active-parent');
                        $parentSubmenu.show();
                    }
                }
            });

            $('.menu-link').on('click', function(e) {
                // If sidebar is collapsed, don't do standard accordion click
                if ($('#wrapper').hasClass('collapsed-sidebar')) {
                    return;
                }

                var $li = $(this).parent();
                if ($li.hasClass('open')) {
                    $li.removeClass('open');
                    $li.find('.submenu').slideUp();
                } else {
                    $('.has-submenu').removeClass('open').find('.submenu').slideUp();
                    $li.addClass('open');
                    $li.find('.submenu').slideDown();
                }
            });
        });
    </script>
    @RenderSection("Script", required: false)
</body>


