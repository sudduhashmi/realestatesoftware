    <!-- App js -->

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            // Sidebar Toggle Logic
            $('#sidebarToggle').click(function() {
                $('#wrapper').toggleClass('collapsed-sidebar');
                
                // Reset open menus when collapsing
                if ($('#wrapper').hasClass('collapsed-sidebar')) {
                    $('.has-submenu').removeClass('open');
                    $('.submenu').hide(); // Instantly hide any accordion-opened menus
                } else {
                    // Restore active menu's parent if in expanded mode
                    $('.has-submenu.active-parent').addClass('open').find('.submenu').show();
                }

                // Save state to localStorage
                var isCollapsed = $('#wrapper').hasClass('collapsed-sidebar');
                localStorage.setItem('sidebar-collapsed', isCollapsed);
            });

            // Restore sidebar state on load
            if (localStorage.getItem('sidebar-collapsed') === 'true') {
                $('#wrapper').addClass('collapsed-sidebar');
            }

            // Toggle the dropdown menu when the dropdown toggle is clicked
            $('.dropdown-toggle').click(function () {
                $(this).next('.dropdown-menu').toggleClass('show');
            });

            // Close the dropdown menu when clicking outside of it
            $(document).click(function (e) {
                if (!$(e.target).closest('.dropdown').length) {
                    $('.dropdown-menu').removeClass('show');
                }
            });

            // Handle Floating Submenu positioning in collapsed mode
            $(document).on('mouseenter', '.collapsed-sidebar .has-submenu', function() {
                var $submenu = $(this).find('.submenu');
                var offset = $(this).offset();
                var scrollTop = $(window).scrollTop();
                
                $submenu.css({
                    'top': (offset.top - scrollTop) + 'px'
                });
            });
        });
    </script>


    <script>
        $(document).ready(function () {
            $("#divload").css({ 'display': 'none' });
        });
        $('#txtid').keypress(function (event) {
            var loginid = $('#txtid').val();
            var keycode = (event.keyCode ? event.keyCode : event.which);
            if (keycode == '13') {
                window.location.href = "/Admin/GlobalSearch?text=" + loginid;
            }
        });
    </script>
